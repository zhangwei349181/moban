---
import type { FooterSocialLinkDisplay } from './content';
import FooterSocialLink from './FooterSocialLink.astro';

interface Props {
  links: FooterSocialLinkDisplay[];
}

const { links } = Astro.props;
---

<div class="flex items-center gap-3">
  {
    links.map((link, index) => (
      <FooterSocialLink link={link} showDivider={index > 0} />
    ))
  }
</div>
