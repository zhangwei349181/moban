---
import type { MenuItem } from '../../../lib/menu';
import { activeMenuChildren, getMenuItemLabel, getMenuItemUrl } from '../../../lib/headerMenu';
import MenuLinkHoverBg from './MenuLinkHoverBg.astro';
import SubmenuArrow from './SubmenuArrow.astro';
import DropdownMenuLinkL3 from './DropdownMenuLinkL3.astro';

interface Props {
  item: MenuItem;
  locale: string;
}

const { item, locale } = Astro.props;
const label = getMenuItemLabel(item, locale);
const href = getMenuItemUrl(item);
const target = item.target && item.target !== '_self' ? item.target : undefined;
const children = activeMenuChildren(item);
const hasSubmenu = children.length > 0;
const flyoutId = `header-submenu-${item.id}`;
---

{
  hasSubmenu ? (
    <li class="nav-submenu-item relative">
      <a
        href={href}
        target={target}
        rel={target ? 'noopener noreferrer' : undefined}
        class="group relative flex items-center gap-2 rounded-[10px] p-3 pr-9"
      >
        <MenuLinkHoverBg />
        {item.icon_url && (
          <span class="relative z-10 rounded-lg border border-stroke-3 p-1" set:html={item.icon_url} />
        )}
        <span class="text-tagline-1 text-secondary relative z-10 font-normal">{label}</span>
        <SubmenuArrow />
      </a>
      <div class="nav-submenu-bridge" aria-hidden="true"></div>
      <ul id={flyoutId} class="nav-submenu-flyout border-stroke-1 rounded-[20px] border bg-white p-3">
        {children.map((child) => (
          <DropdownMenuLinkL3 item={child} locale={locale} />
        ))}
      </ul>
    </li>
  ) : (
    <li>
      <a
        href={href}
        target={target}
        rel={target ? 'noopener noreferrer' : undefined}
        class="group relative flex items-center gap-2 rounded-[10px] p-3"
      >
        <MenuLinkHoverBg />
        {item.icon_url && (
          <span class="relative z-10 rounded-lg border border-stroke-3 p-1" set:html={item.icon_url} />
        )}
        <span class="text-tagline-1 text-secondary relative z-10 font-normal">{label}</span>
      </a>
    </li>
  )
}
