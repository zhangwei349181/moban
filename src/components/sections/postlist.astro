---
/**
 * PostList 列表页区块：带分页的文章/商品列表，布局由 CMS html_url 模板定义。
 * 组件记录 type=postlist 时渲染（旧租户仍可用 code=postlist / postlist01–99）。
 * 不支持 tabs/groups；URL 查询参数 page、category_ids、tag_ids 与 metadata 查询条件合并。
 */
import {
  loadPostListSectionTemplate,
  resolvePostListClientInit,
  resolvePostListSectionMeta,
} from './resolvers/postlist';
import { loadPostListSection } from '../../lib/postListSection';
import { PRODUCT_DETAIL_ARTICLE_TYPES } from '../../lib/postSection';
import { getTenantId } from '../../lib/i18n';
import { getTranslationByLocale } from '../../lib/translations';
import { renderPostListSectionHtml } from '../../lib/postListTemplate';
import { missingTemplateNoticeHtml } from './resolvers/_shared';

interface Props {
  metadata: Record<string, unknown>;
  locale: string;
}

const { metadata, locale } = Astro.props;
const tenantId = getTenantId(Astro);
const clientInit = resolvePostListClientInit(metadata, locale);
const cssUrl = clientInit.cssUrl;
const { listBasePath: listPath, articleTypes } = resolvePostListSectionMeta(metadata);
const isProductList = articleTypes
  .split(',')
  .some((type) => PRODUCT_DETAIL_ARTICLE_TYPES.has(type.trim().toLowerCase()));

let html = '';
try {
  const templateShell = await loadPostListSectionTemplate(metadata, locale, Astro.url);
  if (!templateShell) {
    html = missingTemplateNoticeHtml(locale);
  } else {
    const data = await loadPostListSection(locale, tenantId, metadata, Astro.url);
    html = renderPostListSectionHtml({
      data,
      templateShell,
      labels: {
        emptyMessage: getTranslationByLocale(
          locale,
          isProductList ? 'no_products_found' : 'no_articles_found'
        ),
        errorMessage: getTranslationByLocale(
          locale,
          isProductList ? 'error_loading_products' : 'error_loading_articles'
        ),
        readMoreLabel: getTranslationByLocale(locale, 'read_more'),
        prevLabel: getTranslationByLocale(locale, 'previous'),
        nextLabel: getTranslationByLocale(locale, 'next'),
      },
    });
  }
} catch (error) {
  console.error('[postlist.astro] render failed:', error);
}
---

<div
  class="postlist-section-slot postlist-section-slot--bare"
  data-postlist-slot
  data-list-path={listPath}
  data-use-platform-ui={clientInit.usePlatformUi ? '1' : '0'}
  data-has-custom-init={clientInit.initScriptUrl || clientInit.initScriptInline ? '1' : '0'}
  set:html={html}
/>
{cssUrl && <link rel="stylesheet" href={cssUrl} />}
{clientInit.initScriptUrl && (
  <script src={clientInit.initScriptUrl} data-postlist-custom-init="url" />
)}
{clientInit.initScriptInline && (
  <script is:inline data-postlist-custom-init="inline">
    {clientInit.initScriptInline}
  </script>
)}

<script>
  import { bootPostList } from '../../lib/postListBoot.client';

  function runBoot() {
    const slot = document.querySelector('[data-postlist-slot]');
    const usePlatformUi = slot?.getAttribute('data-use-platform-ui') !== '0';
    bootPostList({ usePlatformUi });
  }

  runBoot();
</script>
