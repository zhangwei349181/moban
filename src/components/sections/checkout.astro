---
/**
 * 结账区块：布局由 CMS html_url 定义，支付由 checkoutUi.client 处理。
 * 组件记录 type=checkout 时渲染（旧租户仍可用 code=checkout / checkoutpage）。
 */
import { resolveCheckoutSectionMeta, loadCheckoutSectionTemplate } from './resolvers/checkout';
import { missingTemplateNoticeHtml } from './resolvers/_shared';
import { renderCheckoutSectionHtml } from '../../lib/checkoutTemplate';
import { resolveCommerceClientInit } from '../../lib/commerceInit';

interface Props {
  metadata: Record<string, unknown>;
  locale: string;
}

const { metadata, locale } = Astro.props;
const sectionMeta = resolveCheckoutSectionMeta(metadata, locale);
const clientInit = resolveCommerceClientInit(metadata, locale);
const cssUrl = clientInit.cssUrl;

let html = '';
try {
  const templateShell = await loadCheckoutSectionTemplate(metadata, locale, Astro.url);
  html = templateShell
    ? renderCheckoutSectionHtml({
        meta: sectionMeta,
        templateShell,
        clientConfig: {
          loginUrl: sectionMeta.loginUrl,
          cartUrl: sectionMeta.cartUrl,
          addressesUrl: sectionMeta.addressesUrl,
          successReturnPath: sectionMeta.successReturnPath,
          cancelReturnPath: sectionMeta.cancelReturnPath,
        },
      })
    : missingTemplateNoticeHtml(locale);
} catch (error) {
  console.error('[checkout.astro] render failed:', error);
}
---

<div
  class="checkout-section-slot checkout-section-slot--bare"
  data-checkout-slot
  data-use-platform-ui={clientInit.usePlatformUi ? '1' : '0'}
  data-has-custom-init={clientInit.initScriptUrl || clientInit.initScriptInline ? '1' : '0'}
  set:html={html}
/>
{cssUrl && <link rel="stylesheet" href={cssUrl} />}
{clientInit.initScriptUrl && (
  <script src={clientInit.initScriptUrl} data-checkout-custom-init="url" />
)}
{clientInit.initScriptInline && (
  <script is:inline data-checkout-custom-init="inline">
    {clientInit.initScriptInline}
  </script>
)}

<script>
  import { bootCheckout } from '../../lib/checkoutBoot.client';

  function runBoot() {
    const slot = document.querySelector('[data-checkout-slot]');
    const usePlatformUi = slot?.getAttribute('data-use-platform-ui') !== '0';
    bootCheckout({ usePlatformUi });
  }

  runBoot();
</script>
