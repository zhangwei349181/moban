---
/**
 * 愿望清单区块：布局由 CMS html_url 定义，卡片由 wishlistUi.client 填充。
 * 组件记录 type=wishlist 时渲染（旧租户仍可用 code=wishlist / wishlistpage）。
 */
import { resolveWishlistSectionMeta, loadWishlistSectionTemplate } from './resolvers/wishlist';
import { missingTemplateNoticeHtml } from './resolvers/_shared';
import { renderWishlistSectionHtml } from '../../lib/wishlistTemplate';
import { resolveCommerceClientInit } from '../../lib/commerceInit';

interface Props {
  metadata: Record<string, unknown>;
  locale: string;
}

const { metadata, locale } = Astro.props;
const sectionMeta = resolveWishlistSectionMeta(metadata, locale);
const clientInit = resolveCommerceClientInit(metadata, locale);
const cssUrl = clientInit.cssUrl;

let html = '';
try {
  const templateShell = await loadWishlistSectionTemplate(metadata, locale, Astro.url);
  html = templateShell
    ? renderWishlistSectionHtml({
        meta: sectionMeta,
        templateShell,
        clientConfig: {
          continueShoppingUrl: sectionMeta.continueShoppingUrl,
          productPageCode: sectionMeta.productPageCode,
        },
      })
    : missingTemplateNoticeHtml(locale);
} catch (error) {
  console.error('[wishlist.astro] render failed:', error);
}
---

<div
  class="wishlist-section-slot wishlist-section-slot--bare"
  data-wishlist-slot
  data-use-platform-ui={clientInit.usePlatformUi ? '1' : '0'}
  data-has-custom-init={clientInit.initScriptUrl || clientInit.initScriptInline ? '1' : '0'}
  set:html={html}
/>
{cssUrl && <link rel="stylesheet" href={cssUrl} />}
{clientInit.initScriptUrl && (
  <script src={clientInit.initScriptUrl} data-wishlist-custom-init="url" />
)}
{clientInit.initScriptInline && (
  <script is:inline data-wishlist-custom-init="inline">
    {clientInit.initScriptInline}
  </script>
)}

<script>
  import { bootWishlist } from '../../lib/wishlistBoot.client';

  function runBoot() {
    const slot = document.querySelector('[data-wishlist-slot]');
    const usePlatformUi = slot?.getAttribute('data-use-platform-ui') !== '0';
    bootWishlist({ usePlatformUi });
  }

  runBoot();
</script>
