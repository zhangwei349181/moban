    // 渲染产品描述和 metadata 按钮
    function renderProductDescription(articleContent: ArticleContentData) {
      const metadata = articleContent.data.metadata || {};
      const metadataKeys = Object.keys(metadata).filter(key => metadata[key]); // 过滤掉空值
      const hasContent = !!articleContent.data.content;
      
      // 1. 渲染按钮
      const buttonList = document.querySelector('.prd-description ul.list-unstyled');
      if (buttonList) {
        // 如果没有 content 也没有 metadata，隐藏按钮区域
        if (!hasContent && metadataKeys.length === 0) {
          const prdDescriptionContainer = buttonList.closest('.prd-description');
          if (prdDescriptionContainer) {
            (prdDescriptionContainer as HTMLElement).style.display = 'none';
          }
          return;
        }
        
        // 清空现有按钮
        buttonList.innerHTML = '';
        
        let defaultKey: string | null = null;
        let defaultIndex = 0;
        
        // 如果有 content，添加 DESCRIPTION 按钮
        if (hasContent) {
          const listItem = document.createElement('li');
          const button = document.createElement('button');
          button.className = 'bg-transparent prd-side-btn active'; // 默认激活
          button.textContent = 'DESCRIPTION';
          button.setAttribute('data-content-type', 'description');
          
          button.addEventListener('click', () => {
            handleButtonClick(buttonList, button);
            renderDescriptionContent(articleContent);
            openSidebar();
          });
          
          listItem.appendChild(button);
          buttonList.appendChild(listItem);
          defaultKey = 'DESCRIPTION';
          defaultIndex = 1;
        }
        
        // 为每个 metadata 键创建按钮
        metadataKeys.forEach((key, index) => {
          const listItem = document.createElement('li');
          const button = document.createElement('button');
          button.className = 'bg-transparent prd-side-btn';
          button.textContent = key;
          button.setAttribute('data-metadata-key', key);
          
          // 如果没有 content，第一个 metadata 按钮默认激活
          if (!hasContent && index === 0) {
            button.classList.add('active');
            defaultKey = key;
          }
          
          // 点击事件
          button.addEventListener('click', () => {
            handleButtonClick(buttonList, button);
            renderMetadataContent(articleContent, key);
            openSidebar();
          });
          
          listItem.appendChild(button);
          buttonList.appendChild(listItem);
        });
        
        // 2. 初始渲染内容
        if (hasContent) {
          // 如果有 content，默认显示 content
          renderDescriptionContent(articleContent);
        } else if (metadataKeys.length > 0) {
          // 如果没有 content，显示第一个 metadata 的内容
          renderMetadataContent(articleContent, metadataKeys[0]);
        }
      }
    }

    // 打开侧边栏
    function openSidebar() {
      const sidebar = document.querySelector('.prd-sidebar-info');
      const overlay = document.querySelector('.prd-sidebar-overlay');
      if (sidebar) {
        sidebar.classList.add('active');
      }
      if (overlay) {
        overlay.classList.add('active');
      }
    }

    // 关闭侧边栏
    function closeSidebar() {
      const sidebar = document.querySelector('.prd-sidebar-info');
      const overlay = document.querySelector('.prd-sidebar-overlay');
      if (sidebar) {
        sidebar.classList.remove('active');
      }
      if (overlay) {
        overlay.classList.remove('active');
      }
    }

    // 处理按钮点击（切换 active 状态）
    function handleButtonClick(buttonList: Element, activeButton: HTMLButtonElement) {
      // 移除所有按钮的 active 类
      buttonList.querySelectorAll('.prd-side-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      // 添加当前按钮的 active 类
      activeButton.classList.add('active');
    }

    // 渲染 description 内容（content 字段）
    function renderDescriptionContent(articleContent: ArticleContentData) {
      const sidebarInfoElement = document.querySelector('.prd-sidebar-info');
      if (sidebarInfoElement && articleContent.data.content) {
        // 构建包含头部的完整HTML结构
        const headerHTML = `
          <div class="header-info pb40 d-flex justify-content-between gap-4 align-items-center">
            <h4 class="title">DESCRIPTION</h4>
