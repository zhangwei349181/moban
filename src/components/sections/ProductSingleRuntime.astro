    // 更新尺寸标题的选中项
    function updateSizeTitle(attributeName: string, valueName: string, attributeId?: string) {
      // 如果指定了 attributeId，只更新对应属性的标题
      const sizeContainers = document.querySelectorAll('.shop-sizes .sizes');
      sizeContainers.forEach((sizeContainer) => {
        // 检查这个容器是否包含指定属性的 input
        if (attributeId) {
          const hasAttribute = sizeContainer.querySelector(`input[data-attribute-id="${attributeId}"]`);
          if (!hasAttribute) {
            return; // 跳过不匹配的容器
          }
        }
        
        const titleElement = sizeContainer.querySelector('.color-title');
        if (titleElement) {
          const currentTitle = titleElement.textContent || '';
          // 检查标题是否匹配当前属性
          if (attributeId && !currentTitle.includes(attributeName)) {
            return; // 标题不匹配，跳过
          }
          
          const activeSpan = titleElement.querySelector('.active');
          if (activeSpan) {
            activeSpan.textContent = valueName;
          } else {
            titleElement.innerHTML = `${attributeName}: <span class="active">${valueName}</span>`;
          }
        }
      });
    }

    // 收集当前选中的属性值
    function getSelectedAttributes(): SelectedAttributes {
      const selectedAttributes: SelectedAttributes = {};

      // 颜色等：radio（.color-plates / .product-attribute-option）
      document.querySelectorAll('input[type="radio"][data-attribute-id]').forEach((input) => {
        const radioInput = input as HTMLInputElement;
        if (radioInput.checked) {
          const attributeId = radioInput.getAttribute('data-attribute-id');
          const attributeValueId = radioInput.getAttribute('data-attribute-value-id');
          if (attributeId && attributeValueId) {
            selectedAttributes[attributeId] = attributeValueId;
          }
        }
      });

      // Fastkart：普通属性为 ul.select-package > a.active（无 radio）
      document.querySelectorAll('.shop-sizes .select-package a.active[data-attribute-id]').forEach((el) => {
        const attributeId = el.getAttribute('data-attribute-id');
        const attributeValueId = el.getAttribute('data-attribute-value-id');
        if (attributeId && attributeValueId) {
          selectedAttributes[attributeId] = attributeValueId;
        }
      });

      return selectedAttributes;
    }

    // 处理属性变更
    function handleAttributeChange(attributeId: string, attributeValueId: string) {
      if (!globalProductData) {
        return;
      }

      // 检查是否有变体和属性
      if (!globalProductData.variants.data.variants || 
          globalProductData.variants.data.variants.length === 0 ||
          !globalProductData.variants.data.attributes || 
          globalProductData.variants.data.attributes.length === 0) {
        // 没有变体，直接返回
        return;
      }

      // 收集当前所有选中的属性值
      const selectedAttributes = getSelectedAttributes();
      
      // 查找匹配的变体
      const matchedVariant = clientVariant.findVariantByAttributes(
        selectedAttributes,
        globalProductData.variants.data.variants,
        globalProductData.variants.data.attributes
      );

      // 更新当前变体
      currentVariant = matchedVariant;

      // 如果已选择众筹，重新匹配回报档位
      if (selectedCrowdfunding) {
        crowdfundingRuntime.matchCrowdfundingRewardAndUpdate();
      } else {
        // 更新价格和库存
        updatePriceAndStock(matchedVariant);
      }
    }

    // 初始化默认变体（使用第一个选中的属性值）
    function initializeDefaultVariant(
      variants: ArticleVariantsData,
      config: ReturnType<typeof getGlobalConfig>
    ) {
      // 检查是否有变体和属性
      if (!variants.data.attributes || variants.data.attributes.length === 0 ||
          !variants.data.variants || variants.data.variants.length === 0) {
        return;
      }

      // 收集当前选中的属性值（应该是页面初始渲染时选中的第一个值）
      const selectedAttributes = getSelectedAttributes();
      
      // 查找匹配的变体
      const matchedVariant = clientVariant.findVariantByAttributes(
        selectedAttributes,
        variants.data.variants,
        variants.data.attributes
      );

      // 更新当前变体
      currentVariant = matchedVariant;

      // 如果找到变体，更新价格和库存
      if (matchedVariant) {
        // 如果已选择众筹，重新匹配回报档位
        if (selectedCrowdfunding) {
          crowdfundingRuntime.matchCrowdfundingRewardAndUpdate();
        } else {
          updatePriceAndStock(matchedVariant);
        }
      }
    }

    // 更新价格和库存
    function updatePriceAndStock(variant: Variant | null) {
      if (!globalProductData) {
        return;
      }

      // 如果已选择团购，优先使用团购价格和库存
      if (selectedGroupBuying) {
        groupBuyingRuntime.updatePriceAndStockWithGroupBuying();
        return;
      }

      // 如果已选择众筹，检查是否有匹配的回报档位
      if (selectedCrowdfunding && variant) {
        crowdfundingRuntime.matchCrowdfundingRewardAndUpdate();
        return;
      }

      if (variant) {
        // 使用变体的价格和库存
        updatePriceWithVariant(variant, globalProductData.discountRules, globalProductData.config);
        updateStockWithVariant(variant);
      } else {
        // 如果没有匹配的变体，使用产品主数据的价格和库存
        updatePriceWithArticle(globalProductData.articleMain, globalProductData.discountRules, globalProductData.config);
        updateStockWithArticle(globalProductData.articleMain);
      }
    }

    // 获取当前选择的数量
    function getCurrentQuantity(): number {
      const quantityInput = document.querySelector('.quantity-num, .qty-input') as HTMLInputElement;
      if (quantityInput) {
        const quantity = parseInt(quantityInput.value, 10);
        return isNaN(quantity) || quantity < 1 ? 1 : quantity;
      }
      return 1; // 默认返回1
    }

    // 计算运费和税费（提前定义，供价格更新函数调用）
    function calculateShippingAndTax() {
      if (!globalProductData || !selectedAddress) {
        // 没有地址时，设置错误状态
        if (!selectedAddress) {
          const errorMessage = clientTranslations.get('select_shipping_address');
          setShippingTaxError('NO_ADDRESS', errorMessage);
        }
        hideShippingTaxSummary();
        return;
      }

      const { shippingTemplates, taxTemplates, regionsData, config, articleMain } = globalProductData;

      // 检查是否有运费模板和税费模板
      if (!shippingTemplates || shippingTemplates.length === 0 || 
          !taxTemplates || taxTemplates.length === 0 ||
          !regionsData || !regionsData.data || !regionsData.data.regions) {
        hideShippingTaxSummary();
        return;
      }

      // 验证地址区域是否在产品的可销售区域内
      const articleRegions = articleMain.data.regions || [];
      const isRegionValid = clientShipping.validateShippingRegion(
        articleRegions,
        selectedAddress.region_id,
        regionsData.data.regions
      );

      if (!isRegionValid) {
        // 区域不可销售，显示错误信息，不进行计算
        const errorMessage = clientTranslations.get('cannot_ship_to_region_error');
        setShippingTaxError('CANNOT_SHIP_TO_REGION', errorMessage);
        renderShippingTaxSummary({
          subtotal: 0,
          shippingFee: 0,
          taxFee: 0,
          total: 0,
          shippingRuleName: '',
          taxRuleName: '',
          shippingError: errorMessage,
          taxError: undefined,
          currency: config.currentCurrency,
        });
        return;
      }

      // 获取当前数量和折扣后的单价
      const quantity = getCurrentQuantity();
      const basePriceInCurrentCurrency = currentDiscountedPrice || 0;

      if (basePriceInCurrentCurrency <= 0) {
        // 如果价格还没有计算出来，等待价格计算完成
        return;
      }

      // 使用当前选中的运费模板和税费模板
      const shippingTemplate = shippingTemplates[selectedShippingTemplateIndex];
      const taxTemplate = taxTemplates[selectedTaxTemplateIndex];

      if (!shippingTemplate || !taxTemplate) {
        hideShippingTaxSummary();
        return;
      }

      // 运费模板中的价格（base_price, unit_price, min_value）是基础货币
      // 需要将当前货币的价格转换为基础货币用于计算
      const isBaseCurrency = config.defaultCurrency && config.currentCurrency && 
        (config.currentCurrency.is_base_currency || 
         config.currentCurrency.currency_code === config.defaultCurrency.currency_code);
      
      // 将当前货币的价格转换为基础货币（除以汇率）
      // exchangeRate 是从基础货币到当前货币的汇率，所以反向转换需要除以汇率
      const basePriceInBaseCurrency = isBaseCurrency 
        ? basePriceInCurrentCurrency 
        : (basePriceInCurrentCurrency / (config.exchangeRate || 1));

      // 计算运费（使用基础货币的价格）
      const shippingResult = clientShipping.calculateShippingFee(
        shippingTemplate,
        selectedAddress,
        regionsData.data.regions,
        quantity,
        basePriceInBaseCurrency,
        currentVariant || undefined,
        articleMain
      );

      // 如果当前模板没有匹配规则，且有多个模板，显示错误但不隐藏摘要（允许用户切换模板）
      if (shippingResult.error && shippingTemplates.length > 1) {
        const errorMessage = clientTranslations.get('current_template_no_matching_rule');
        setShippingTaxError('NO_MATCHING_RULE', errorMessage);
        // subtotal 是当前货币（basePriceInCurrentCurrency 是当前货币）
        const subtotal = quantity * basePriceInCurrentCurrency;
        renderShippingTaxSummary({
          subtotal: subtotal,
          shippingFee: 0,
          taxFee: 0,
          total: subtotal,
          shippingRuleName: '',
          taxRuleName: '',
          shippingError: errorMessage,
          taxError: undefined,
          currency: config.currentCurrency,
        });
        return;
      }

      // 如果当前模板没有匹配规则，且只有一个模板，显示错误
      if (shippingResult.error) {
        setShippingTaxError('NO_MATCHING_RULE', shippingResult.error);
        // subtotal 是当前货币（basePriceInCurrentCurrency 是当前货币）
        const subtotal = quantity * basePriceInCurrentCurrency;
        renderShippingTaxSummary({
          subtotal: subtotal,
          shippingFee: 0,
          taxFee: 0,
          total: subtotal,
          shippingRuleName: '',
          taxRuleName: '',
          shippingError: shippingResult.error,
          taxError: undefined,
          currency: config.currentCurrency,
        });
        return;
      }

      // 计算税费（使用基础货币的价格）
      const taxResult = clientShipping.calculateTaxFee(
        taxTemplate,
        selectedAddress,
        regionsData.data.regions,
        quantity,
        basePriceInBaseCurrency
      );

      // 运费和税费的计算结果都是基础货币，需要转换为当前货币用于显示
      const exchangeRate = config.exchangeRate || 1;
      const shippingFeeInCurrentCurrency = shippingResult.shippingFee * exchangeRate;
      const taxFeeInCurrentCurrency = taxResult.taxFee * exchangeRate;

      // 计算小计（数量 × 折扣后单价，当前货币）
      const subtotal = quantity * basePriceInCurrentCurrency;

      // 计算总计（当前货币）
      const total = subtotal + shippingFeeInCurrentCurrency + taxFeeInCurrentCurrency;

      // 用于显示的值（当前货币）
      const displaySubtotal = subtotal;
      const displayShipping = shippingFeeInCurrentCurrency;
      const displayTax = taxFeeInCurrentCurrency;
      const displayTotal = total;

      // 如果计算成功且没有错误，清除错误状态
      if (!shippingResult.error && !taxResult.error) {
        clearShippingTaxError();
        
        // 保存当前运费和税费信息（用于添加到购物车）
        // 注意：保存当前货币的值，添加到购物车时会转换为基础货币
        const shippingTemplate = shippingTemplates[selectedShippingTemplateIndex];
        const taxTemplate = taxTemplates[selectedTaxTemplateIndex];
        currentShippingTaxInfo = {
          shippingFee: displayShipping, // 当前货币
          taxFee: displayTax, // 当前货币
          shippingTemplateId: shippingTemplate?.data.template.id,
          taxTemplateId: taxTemplate?.data.template.id,
        };
      } else {
        // 如果仍有错误，设置错误状态
        if (shippingResult.error) {
          setShippingTaxError('NO_MATCHING_RULE', shippingResult.error);
        }
        if (taxResult.error) {
          // 税费错误暂时使用相同的错误类型，可以根据需要扩展
          setShippingTaxError('NO_MATCHING_RULE', taxResult.error);
        }
        // 如果有错误，清空运费税费信息
        currentShippingTaxInfo = null;
      }

      // 渲染结果
      // 注意：这些值已经是当前货币，不需要转换
      renderShippingTaxSummary({
        subtotal: displaySubtotal,
        shippingFee: displayShipping,
        taxFee: displayTax,
        total: displayTotal,
        shippingRuleName: shippingResult.ruleName || '',
        taxRuleName: taxResult.ruleName || '',
        shippingError: shippingResult.error,
        taxError: taxResult.error,
        currency: config.currentCurrency,
      });
    }

    // 隐藏运费和税费摘要
    function hideShippingTaxSummary() {
      const summaryDetails = document.getElementById('summary-details');
      if (summaryDetails) {
        summaryDetails.style.display = 'none';
      }
      // 隐藏时也清除错误状态（因为摘要已隐藏，不再需要显示错误）
      clearShippingTaxError();
    }

    // 渲染运费和税费摘要
    function renderShippingTaxSummary(data: {
      subtotal: number;
      shippingFee: number;
      taxFee: number;
      total: number;
      shippingRuleName: string;
      taxRuleName: string;
      shippingError?: string;
      taxError?: string;
      currency: any;
    }) {
      const summaryDetails = document.getElementById('summary-details');
      const errorElement = document.getElementById('shipping-tax-error');
      const errorMessage = document.getElementById('error-message');

      if (!summaryDetails) {
        return;
      }

      // 检查是否有错误
      const errors: string[] = [];
      if (data.shippingError) {
        errors.push(data.shippingError);
      }
      if (data.taxError) {
        errors.push(data.taxError);
      }

      // 显示/隐藏错误提示
      if (errorElement && errorMessage) {
        if (errors.length > 0) {
          errorMessage.textContent = errors.join('; ');
          errorElement.style.display = 'block';
        } else {
          errorElement.style.display = 'none';
        }
      }

      // 更新金额显示
      const subtotalValue = document.getElementById('subtotal-value');
      const shippingValue = document.getElementById('shipping-value');
      const taxValue = document.getElementById('tax-value');
      const totalValue = document.getElementById('total-value');
      const shippingRuleName = document.getElementById('shipping-rule-name');
      const taxRuleName = document.getElementById('tax-rule-name');

      if (subtotalValue) {
        subtotalValue.textContent = data.currency 
          ? clientPricing.formatPrice(data.subtotal, data.currency)
          : data.subtotal.toFixed(2);
      }

      if (shippingValue) {
        shippingValue.textContent = data.currency
          ? clientPricing.formatPrice(data.shippingFee, data.currency)
          : data.shippingFee.toFixed(2);
      }

      if (taxValue) {
        taxValue.textContent = data.currency
          ? clientPricing.formatPrice(data.taxFee, data.currency)
          : data.taxFee.toFixed(2);
      }

      if (totalValue) {
        totalValue.textContent = data.currency
          ? clientPricing.formatPrice(data.total, data.currency)
          : data.total.toFixed(2);
      }

      // 显示规则名称
      if (shippingRuleName && data.shippingRuleName) {
        shippingRuleName.textContent = `(${data.shippingRuleName})`;
      } else if (shippingRuleName) {
        shippingRuleName.textContent = '';
      }

      if (taxRuleName && data.taxRuleName) {
        taxRuleName.textContent = `(${data.taxRuleName})`;
      } else if (taxRuleName) {
        taxRuleName.textContent = '';
      }

      // 显示摘要详情容器（但内容是否显示由折叠状态控制）
      summaryDetails.style.display = 'block';
      
      // 如果地址选择器已展开，则同时展开摘要详情
      const detailsCollapsible = document.getElementById('shipping-details-collapsible');
      const summaryCollapsible = document.getElementById('summary-details-collapsible');
      if (detailsCollapsible && summaryCollapsible) {
        // 如果地址详情是展开的，则摘要详情也展开
        if (detailsCollapsible.style.display === 'block') {
          summaryCollapsible.style.display = 'block';
        }
      }
    }

    // 使用变体价格更新显示
    function updatePriceWithVariant(
      variant: Variant,
      discountRules: DiscountRulesData,
