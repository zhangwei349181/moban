---

<script>
  import { clientProduct } from '../../lib/product.js';
  import {
    clientPricing,
    matchesCrowdfundingUserRestrictions,
    matchesDiscountUserRestrictions,
    matchesGroupBuyingUserRestrictions,
  } from '../../lib/pricing.js';
  import type { DiscountViewerContext } from '../../lib/pricing.js';
  import { clientShipping } from '../../lib/shipping.js';
  import { clientVariant } from '../../lib/variant.js';
  import { postAddCartItem, syncLocalCartFromServer } from '../../lib/cart-api.js';
  import { isAuthenticated, getCurrentMembershipId, getUser, getCurrentMembership } from '../../lib/auth.js';
  import { clientTranslations } from '../../lib/translations.js';
  import { isInWishlist, toggleWishlist } from '../../lib/wishlist.js';
  import {
    adjustPlainProductPricesForGlobalTier,
    categoryIdsFromProductLike,
    isUnregisteredPriceUiHidden,
  } from '../../lib/globalDiscountPrice.js';
  import { createShopGroupBuying } from '../../lib/shopProductGroupBuying.js';
  import { createShopCrowdfunding } from '../../lib/shopProductCrowdfunding.js';
  import type {
    ArticleMainData,
    ArticleContentData,
    ArticleVariantsData,
    DiscountRulesData,
    ShippingTemplateData,
    TaxTemplateData,
    RegionsData,
    CategoryData,
    TagData,
    UserProfileData,
    Variant,
    Attribute,
    AttributeValue,
    Discount,
    Address,
    GroupBuyingData,
    GroupBuyingActivity,
    CrowdfundingData,
    CrowdfundingActivity,
    CrowdfundingReward,
  } from '../../lib/product.js';
  import type { SelectedAttributes } from '../../lib/variant.js';
  import type { AppliedDiscountDetail } from '../../lib/pricing.js';

  (function() {
    // 全局产品数据存储（用于变体匹配和价格更新）
    let globalProductData: {
      articleMain: ArticleMainData;
      articleContent: ArticleContentData;
      variants: ArticleVariantsData;
      discountRules: DiscountRulesData;
      shippingTemplates: ShippingTemplateData[];
      taxTemplates: TaxTemplateData[];
      regionsData: RegionsData | null;
      userProfile: UserProfileData | null;
      groupBuyingData: GroupBuyingData | null;
      crowdfundingData: CrowdfundingData | null;
      config: ReturnType<typeof getGlobalConfig>;
    } | null = null;

    // 当前选中的变体
    let currentVariant: Variant | null = null;

    // 当前选中的团购活动
    let selectedGroupBuying: GroupBuyingActivity | null = null;

    // 当前选中的众筹活动
    let selectedCrowdfunding: CrowdfundingActivity | null = null;

    // 当前匹配的众筹回报档位
    let matchedCrowdfundingReward: CrowdfundingReward | null = null;

    /** 当前商品分类 ID，用于全局折扣中的分类乘数 */
    let productCategoryIdsForDiscount: string[] = [];

    // 当前选中的地址
    let selectedAddress: Address | null = null;

    // 当前选中的运费模板索引（默认第一个）
    let selectedShippingTemplateIndex: number = 0;

    // 当前选中的税费模板索引（默认第一个）
    let selectedTaxTemplateIndex: number = 0;

    // 当前折扣后的单价（用于运费和税费计算）
    let currentDiscountedPrice: number = 0;

    // 当前价格信息（用于添加到购物车）
    let currentPriceInfo: {
      originalPrice: number;
      discountedPrice: number;
      discountAmount: number;
      discountResult?: any; // applyDiscountWithDetails 的返回值
    } | null = null;

    // 当前运费和税费信息（用于添加到购物车）
    let currentShippingTaxInfo: {
      shippingFee: number;
      taxFee: number;
      shippingTemplateId?: string;
      taxTemplateId?: string;
    } | null = null;

    // 运费税费计算的全局错误状态
    type ShippingTaxErrorType = 
      | 'NO_ADDRESS'           // 请选择收货地址以计算运费和税费
      | 'NOT_LOGGED_IN'        // 请登录以计算运费和税费
      | 'NO_SHIPPING_TEMPLATE' // 该产品未配置运费模板
      | 'NO_TAX_TEMPLATE'      // 该产品未配置税费模板
      | 'CANNOT_SHIP_TO_REGION' // 产品无法销售到该区域
      | 'NO_MATCHING_RULE'      // 当前模板无匹配规则
      | 'NONE';                 // 无错误

    interface ShippingTaxErrorState {
      type: ShippingTaxErrorType;
      message: string;
      timestamp: number;
    }

    let shippingTaxErrorState: ShippingTaxErrorState = {
      type: 'NONE',
      message: '',
      timestamp: 0,
    };

    // 设置运费税费错误状态
    function setShippingTaxError(type: ShippingTaxErrorType, message: string) {
      const previousState = { ...shippingTaxErrorState };
      shippingTaxErrorState = {
        type,
        message,
        timestamp: Date.now(),
      };

      const timestamp = new Date().toISOString();
      if (previousState.type !== type) {
        console.log(`[运费税费错误状态变化] ${timestamp}`);
        console.log(`  从: ${previousState.type} (${previousState.message})`);
        console.log(`  到: ${type} (${message})`);
        console.log(`  状态对象:`, shippingTaxErrorState);
      } else {
        console.log(`[运费税费错误状态更新] ${timestamp}`);
        console.log(`  类型: ${type} (${message})`);
        console.log(`  状态对象:`, shippingTaxErrorState);
      }
    }

    // 清除运费税费错误状态
    function clearShippingTaxError() {
      const previousState = { ...shippingTaxErrorState };
      if (previousState.type !== 'NONE') {
        shippingTaxErrorState = {
          type: 'NONE',
          message: '',
          timestamp: Date.now(),
        };

        const timestamp = new Date().toISOString();
        console.log(`[运费税费错误状态清除] ${timestamp}`);
        console.log(`  从: ${previousState.type} (${previousState.message})`);
        console.log(`  到: NONE (无错误)`);
        console.log(`  状态对象:`, shippingTaxErrorState);
      }
    }

    // 获取运费税费错误状态（供外部调用，如提交购物车时检查）
    function getShippingTaxErrorState(): ShippingTaxErrorState {
      return { ...shippingTaxErrorState };
    }

    // 检查是否有运费税费错误（供外部调用）
    function hasShippingTaxError(): boolean {
      return shippingTaxErrorState.type !== 'NONE';
    }

    // 将错误状态检查函数暴露到全局作用域，方便提交购物车时调用
    (window as any).getShippingTaxErrorState = getShippingTaxErrorState;
    (window as any).hasShippingTaxError = hasShippingTaxError;

    // 获取全局配置
    function getGlobalConfig() {
      const win = window as any;
      return {
        tenantId: win.__ASTRO_TENANT_ID__ || '',
        locale: win.__ASTRO_LOCALE__ || 'zh-CN',
        currentCurrency: win.__ASTRO_CURRENT_CURRENCY__ || null,
        defaultCurrency: win.__ASTRO_DEFAULT_CURRENCY__ || null,
        exchangeRate: win.__ASTRO_EXCHANGE_RATE__ || 1,
        apiBaseUrl: win.__ASTRO_API_BASE_URL_01__ || '',
      };
    }

    // 获取产品ID
    function getArticleId(): string | null {
      const section = document.querySelector('[data-productsingle-section][data-article-id]');
      if (!section) return null;
      return section.getAttribute('data-article-id');
    }

    /** 折扣用户维度：membership.level（无则 null）；membership_restriction 使用 User.id */
    function getDiscountViewerContext(): DiscountViewerContext {
      const user = getUser();
      const mem = getCurrentMembership();
      const levelRaw = mem?.level;
      const level =
        levelRaw !== undefined &&
        levelRaw !== null &&
        String(levelRaw).trim() !== ''
          ? String(levelRaw).trim()
          : null;
      return {
        userId: user?.id ?? null,
        level,
      };
    }

    // 获取用户数据（如果已登录）
    async function getUserProfileIfLoggedIn(
      config: ReturnType<typeof getGlobalConfig>
    ): Promise<UserProfileData | null> {
      if (!isAuthenticated()) {
        return null;
      }

      const membershipId = getCurrentMembershipId();
      if (!membershipId) {
        return null;
      }

      try {
        return await clientProduct.fetchUserProfile(membershipId, config.tenantId);
      } catch (error) {
        console.error('Failed to fetch user profile:', error);
        return null;
      }
    }

    interface ProductSingleSsrPayload {
      articleMain: ArticleMainData;
      articleContent: ArticleContentData;
      variants: ArticleVariantsData;
      discountRules: DiscountRulesData;
      categories: CategoryData[];
      tags: TagData[];
      shippingTemplates: ShippingTemplateData[];
      taxTemplates: TaxTemplateData[];
      regionsData: RegionsData | null;
      groupBuyingData: GroupBuyingData | null;
      crowdfundingData: CrowdfundingData | null;
    }

    function readSsrPayload(): ProductSingleSsrPayload | null {
      const el = document.getElementById('product-single-ssr-payload');
      if (!el?.textContent?.trim()) return null;
      try {
        return JSON.parse(el.textContent) as ProductSingleSsrPayload;
      } catch {
        return null;
      }
    }

    // 加载产品数据主函数
    async function loadProductData(articleId: string) {
      const config = getGlobalConfig();

      const ssrPayload = readSsrPayload();
      if (ssrPayload) {
        try {
          showLoadingState();
          const userProfile = await getUserProfileIfLoggedIn(config);
          renderProductPage({
            ...ssrPayload,
            userProfile,
            config,
          });
        } catch (error) {
          console.error('=== SSR 产品数据渲染失败 ===', error);
          showErrorState(error instanceof Error ? error.message : '加载产品数据失败');
        } finally {
          hideLoadingState();
        }
        return;
      }
      
      try {
        // 显示加载状态
        console.log('=== 开始加载产品数据 ===');
        showLoadingState();

        // 1. 获取用户数据（如果已登录）
        console.log('1. 获取用户数据...');
        const userProfile = await getUserProfileIfLoggedIn(config);
        console.log('用户数据获取完成');

        // 2. 并行加载核心数据
        console.log('2. 并行加载核心数据...');
        const [articleMain, articleContent, variantsRes, discountRules] = await Promise.all([
          clientProduct.fetchArticleMain(articleId, config.tenantId),
          clientProduct.fetchArticleContent(articleId, config.locale, config.tenantId),
          clientProduct.fetchArticleVariants(articleId, config.tenantId),
          clientProduct.fetchDiscountRules(articleId, config.tenantId),
        ]);
        console.log('核心数据加载完成');

        // 变体接口可能返回 data.attributes / data.variants 为 null（新商品或未配置变体）
        const variants: ArticleVariantsData = {
          success: variantsRes?.success ?? true,
          data: {
            attributes: Array.isArray(variantsRes?.data?.attributes) ? variantsRes.data.attributes : [],
            variants: Array.isArray(variantsRes?.data?.variants) ? variantsRes.data.variants : [],
          },
        };

        // 3. 加载关联数据（主数据里各 id 数组可能为 null，需兜底避免 .map 报错）
        const loadPromises: Promise<any>[] = [];

        const categoryIds = articleMain.data.categories ?? [];
        const tagIds = articleMain.data.tags ?? [];
        const shippingTemplateIds = articleMain.data.shipping_template_ids ?? [];
        const taxTemplateIds = articleMain.data.tax_template_ids ?? [];

        // 加载分类数据
        const categoryPromises = categoryIds.map(categoryId =>
          clientProduct.fetchCategory(categoryId, config.tenantId).catch(err => {
            console.error(`Failed to fetch category ${categoryId}:`, err);
            return null;
          })
        );
        loadPromises.push(...categoryPromises);

        // 加载标签数据
        const tagPromises = tagIds.map(tagId =>
          clientProduct.fetchTag(tagId, config.tenantId).catch(err => {
            console.error(`Failed to fetch tag ${tagId}:`, err);
            return null;
          })
        );
        loadPromises.push(...tagPromises);

        // 加载运费模板数据
        const shippingTemplatePromises = shippingTemplateIds.map(templateId =>
          clientProduct.fetchShippingTemplate(templateId, config.tenantId).catch(err => {
            console.error(`Failed to fetch shipping template ${templateId}:`, err);
            return null;
          })
        );
        loadPromises.push(...shippingTemplatePromises);

        // 加载税费模板数据
        const taxTemplatePromises = taxTemplateIds.map(templateId =>
          clientProduct.fetchTaxTemplate(templateId, config.tenantId).catch(err => {
            console.error(`Failed to fetch tax template ${templateId}:`, err);
            return null;
          })
        );
        loadPromises.push(...taxTemplatePromises);

        // 加载区域数据（只需要加载一次）
        const regionsPromise = clientProduct.fetchRegions(config.tenantId).catch(err => {
          console.error('Failed to fetch regions:', err);
          return null;
        });
        loadPromises.push(regionsPromise);

        // 等待所有关联数据加载完成
        const results = await Promise.all(loadPromises);
        
        // 处理结果（切片长度与上方 categoryIds / tagIds / shippingTemplateIds / taxTemplateIds 一致）
        const categories = results.slice(0, categoryIds.length).filter(Boolean) as CategoryData[];
        const tags = results.slice(
          categoryIds.length,
          categoryIds.length + tagIds.length
        ).filter(Boolean) as TagData[];
        const shippingTemplates = results.slice(
          categoryIds.length + tagIds.length,
          categoryIds.length + tagIds.length + shippingTemplateIds.length
        ).filter(Boolean) as ShippingTemplateData[];
        const taxTemplates = results.slice(
          categoryIds.length + tagIds.length + shippingTemplateIds.length,
          categoryIds.length + tagIds.length + shippingTemplateIds.length + taxTemplateIds.length
        ).filter(Boolean) as TaxTemplateData[];
        const regionsData = results[results.length - 1] as RegionsData | null;

        // 3.5. 如果是团购产品，加载团购数据
        let groupBuyingData: GroupBuyingData | null = null;
        if (articleMain.data.article.article_type === 'group_product') {
          try {
            console.log('=== 开始加载团购数据 ===');
            console.log('articleId:', articleId, 'tenantId:', config.tenantId);
            groupBuyingData = await clientProduct.fetchGroupBuying(articleId, config.tenantId);
            console.log('团购数据加载成功:', groupBuyingData);
          } catch (error) {
            console.error('Failed to fetch group buying data:', error);
            groupBuyingData = null;
          }
        } else {
          console.log('产品类型不是 group_product，跳过团购数据加载，当前类型:', articleMain.data.article.article_type);
        }

        // 3.6. 如果是众筹产品，加载众筹数据
        let crowdfundingData: CrowdfundingData | null = null;
        if (articleMain.data.article.article_type === 'crowdfunding_product') {
          try {
            console.log('=== 开始加载众筹数据 ===');
            console.log('articleId:', articleId, 'tenantId:', config.tenantId);
            crowdfundingData = await clientProduct.fetchCrowdfunding(articleId, config.tenantId);
            console.log('众筹数据加载成功:', crowdfundingData);
          } catch (error) {
            console.error('Failed to fetch crowdfunding data:', error);
            crowdfundingData = null;
          }
        } else {
          console.log('产品类型不是 crowdfunding_product，跳过众筹数据加载，当前类型:', articleMain.data.article.article_type);
        }

        // 4. 处理数据并渲染页面
        console.log('4. 开始渲染产品页面...');
        renderProductPage({
          articleMain,
          articleContent,
          variants,
          discountRules,
          categories,
          tags,
          shippingTemplates,
          taxTemplates,
          regionsData,
          userProfile,
          groupBuyingData,
          crowdfundingData,
          config,
        });
        console.log('产品页面渲染完成');

        // 隐藏加载状态
        console.log('隐藏加载动画...');
        hideLoadingState();

      } catch (error) {
        console.error('=== 加载产品数据失败 ===');
        console.error('错误详情:', error);
        showErrorState(error instanceof Error ? error.message : '加载产品数据失败');
      } finally {
        // 确保无论如何都会隐藏加载状态
        hideLoadingState();
      }
    }

    // 显示加载状态
    function showLoadingState() {
      const loadingOverlay = document.getElementById('product-loading-overlay');
      const loadingText = document.getElementById('loading-text');
      if (loadingOverlay) {
        // 重置样式，确保显示
        loadingOverlay.style.opacity = '1';
        loadingOverlay.style.transition = '';
        // 使用 !important 强制覆盖 Bootstrap 的 d-flex 类
        loadingOverlay.style.setProperty('display', 'flex', 'important');
        console.log('显示加载动画');
      } else {
        console.warn('加载动画元素未找到');
      }
      // 更新加载文本（国际化）
      if (loadingText) {
        const config = getGlobalConfig();
        loadingText.textContent = clientTranslations.get('loading_product_data');
      }
      console.log('Loading product data...');
    }

    // 隐藏加载状态
    function hideLoadingState() {
      const loadingOverlay = document.getElementById('product-loading-overlay');
      if (loadingOverlay) {
        // 检查当前计算后的样式，而不是内联样式
        const computedStyle = window.getComputedStyle(loadingOverlay);
        if (computedStyle.display === 'none') {
          console.log('加载动画已经隐藏，跳过');
          return;
        }
        
        // 使用 !important 强制隐藏（因为 d-flex 类可能覆盖内联样式）
        loadingOverlay.style.setProperty('display', 'none', 'important');
        loadingOverlay.style.opacity = '1'; // 重置透明度，以便下次显示
        loadingOverlay.style.transition = ''; // 清除过渡效果
        
        console.log('加载动画已隐藏');
      } else {
        console.warn('加载动画元素未找到');
      }
    }

    // 显示错误状态
    function showErrorState(message: string) {
      // TODO: 实现错误提示
      console.error('Error:', message);
      alert(message);
    }

    // 渲染产品页面
    function renderProductPage(data: {
      articleMain: ArticleMainData;
      articleContent: ArticleContentData;
      variants: ArticleVariantsData;
      discountRules: DiscountRulesData;
      categories: CategoryData[];
      tags: TagData[];
      shippingTemplates: ShippingTemplateData[];
      taxTemplates: TaxTemplateData[];
      regionsData: RegionsData | null;
      userProfile: UserProfileData | null;
      groupBuyingData: GroupBuyingData | null;
      crowdfundingData: CrowdfundingData | null;
      config: ReturnType<typeof getGlobalConfig>;
    }) {
      const {
        articleMain,
        articleContent,
        variants,
        discountRules,
        categories,
        tags,
        shippingTemplates,
        taxTemplates,
        regionsData,
        userProfile,
        groupBuyingData,
        crowdfundingData,
        config,
      } = data;

      productCategoryIdsForDiscount = categoryIdsFromProductLike(articleMain);
      if (typeof window !== 'undefined') {
        (window as any).__ASTRO_PRODUCT_CATEGORY_IDS__ = productCategoryIdsForDiscount;
      }

      // 1. 渲染产品标题和标签
      renderProductTitle(articleContent, tags, config.locale);
      
      // 1.5. 初始化价格和库存标签（国际化）
      initPriceAndStockLabels(config.locale);
      
      // 2. 渲染产品简介
      renderProductSummary(articleContent);
      
      // 2.5. 渲染团购活动列表（如果有团购数据）
      console.log('=== 检查是否渲染团购列表 ===');
      console.log('groupBuyingData:', groupBuyingData);
      if (groupBuyingData && groupBuyingData.data && groupBuyingData.data.group_buying) {
        console.log('有团购数据，调用 renderGroupBuyingList');
        groupBuyingRuntime.renderGroupBuyingList(groupBuyingData, config.locale);
      } else {
        console.log('没有团购数据，跳过渲染');
      }
      
      // 2.6. 渲染众筹活动列表（如果有众筹数据）
      console.log('=== 检查是否渲染众筹列表 ===');
      console.log('crowdfundingData:', crowdfundingData);
      if (crowdfundingData && crowdfundingData.data && crowdfundingData.data.crowdfunding) {
        console.log('有众筹数据，调用 renderCrowdfundingList');
        crowdfundingRuntime.renderCrowdfundingList(crowdfundingData, config.locale);
      } else {
        console.log('没有众筹数据，跳过渲染');
      }
      
      // 3. 渲染产品图片
      renderProductImages(articleMain);
      
      // 4. 渲染产品价格
      renderProductPrice(articleMain, variants, discountRules, config);
      
      // 5. 渲染产品库存
      renderProductStock(articleMain, variants);
      
      // 5.5. 渲染折扣规则列表
      renderDiscountRules(discountRules, config.locale);
      
      // 6. 渲染产品属性（颜色、尺寸等）
      if (variants.data.attributes && variants.data.attributes.length > 0) {
        renderProductAttributes(variants, config.locale);
      } else {
        // 如果没有属性，隐藏属性容器
        hideAttributeContainers();
      }
      
      // 7. 渲染产品描述
      renderProductDescription(articleContent);
      
      // 8. 渲染分类（标签已在标题处渲染）
      // renderCategoriesAndTags(categories, tags, config.locale);

      // 保存全局产品数据
      globalProductData = {
        articleMain,
        articleContent,
        variants,
        discountRules,
        shippingTemplates,
        taxTemplates,
        regionsData,
        userProfile,
        groupBuyingData,
        crowdfundingData,
        config,
      };

      // 初始化UI交互
      initProductInteractions({
        articleMain,
        variants,
        discountRules,
        shippingTemplates,
        taxTemplates,
        regionsData,
        userProfile,
        groupBuyingData,
        crowdfundingData,
        config,
      });

      // 初始化默认变体（使用第一个选中的属性值）
      // 使用 setTimeout 确保属性渲染完成后再初始化
      setTimeout(() => {
        initializeDefaultVariant(variants, config);
      }, 0);
    }

    // 获取标签的显示名称（支持多语言）
    function getTagDisplayName(tag: TagData, locale: string): string {
      if (!tag || !tag.data || !tag.data.tag) {
        return '';
      }

      const tagData = tag.data.tag;

      // 根据文档，translations 在 data.translations 下，而不是 tag.translations
      // 如果指定了语言，查找翻译
      if (locale && tag.data.translations && tag.data.translations.length > 0) {
        const translation = tag.data.translations.find(t => t.language_code === locale);
        if (translation && (translation as any).name) {
          return (translation as any).name;
        }
      }

      // 返回默认名称（主语言名称）
      return tagData.name || '';
    }

    // 初始化价格和库存标签（国际化）
    function initPriceAndStockLabels(locale: string) {
      const originalPriceLabel = document.querySelector('.original-price-label');
      const discountedPriceLabel = document.querySelector('.discounted-price-label');
      const stockLabel = document.querySelector('.stock-label');

      if (originalPriceLabel) {
        originalPriceLabel.textContent = clientTranslations.get('original_price');
      }
      if (discountedPriceLabel) {
        discountedPriceLabel.textContent = clientTranslations.get('discounted_price');
      }
      if (stockLabel) {
        stockLabel.textContent = clientTranslations.get('stock');
      }
    }

    // 渲染产品标题和标签
    function renderProductTitle(
      articleContent: ArticleContentData,
      tags: TagData[],
      locale: string
    ) {
      const titleElement =
        document.querySelector('.shop-prd-title .title') || document.querySelector('.right-box-contain .name');
      if (titleElement) {
        titleElement.textContent = articleContent.data.title;
      }

      const displayTags = tags.map(tag => getTagDisplayName(tag, locale)).filter(Boolean);
      const fkOffers = document.querySelectorAll('.right-box-contain .offer-top');
      if (fkOffers.length) {
        fkOffers.forEach((el, i) => {
          const h = el as HTMLElement;
          if (displayTags[i]) {
            h.textContent = displayTags[i];
            h.style.display = '';
          } else {
            h.textContent = '';
            h.style.display = 'none';
          }
        });
        const subtitleElement = document.querySelector('.shop-prd-title .subtitle');
        if (subtitleElement) (subtitleElement as HTMLElement).style.display = 'none';
        return;
      }

      const subtitleElement = document.querySelector('.shop-prd-title .subtitle');
      if (subtitleElement) {
        const shortTags = displayTags.slice(0, 2);
        if (shortTags.length > 0) {
          subtitleElement.textContent = shortTags.join(' / ');
          (subtitleElement as HTMLElement).style.display = '';
        } else {
          subtitleElement.textContent = '';
          (subtitleElement as HTMLElement).style.display = 'none';
        }
      }
    }

    // 渲染产品简介
    function renderProductSummary(articleContent: ArticleContentData) {
      const fkSummary = document.querySelector('.product-contain p');
      if (fkSummary) {
        const wrap = fkSummary.closest('.product-contain') as HTMLElement | null;
        if (articleContent.data.summary) {
          fkSummary.textContent = articleContent.data.summary;
          if (wrap) wrap.style.display = '';
        } else if (wrap) {
          wrap.style.display = 'none';
        }
        return;
      }
      const summaryElement = document.querySelector('.pre-order p.mb-0.d-flex');
      if (summaryElement && articleContent.data.summary) {
        // 保留图标，只更新文本内容
        const iconElement = summaryElement.querySelector('.icon');
        if (iconElement) {
          summaryElement.innerHTML = '';
          summaryElement.appendChild(iconElement);
          const textNode = document.createTextNode(articleContent.data.summary);
          summaryElement.appendChild(textNode);
        } else {
          summaryElement.textContent = articleContent.data.summary;
        }
      } else if (summaryElement && !articleContent.data.summary) {
        // 如果没有简介，隐藏该区域
        const preOrderContainer = summaryElement.closest('.pre-order');
        if (preOrderContainer) {
          (preOrderContainer as HTMLElement).style.display = 'none';
        }
      }
    }


    // 获取众筹活动的显示名称（支持多语言）
    function renderProductImages(articleMain: ArticleMainData) {
      const images = articleMain.data.article.metadata.template_fields["Showcase Gallery"] || [];
      
      if (images.length === 0) {
        // 使用默认占位图
        images.push('/images/placeholder.jpg');
      }

      const galleryRoot = document.querySelector('.product-single-gallery-main');
      if (galleryRoot) {
        const buildSlide = (src: string, idx: number) =>
          `<div class="swiper-slide${idx === 0 ? ' is-active swiper-slide-active' : ''}"><img src="${src}" ${idx === 0 ? 'id="img-1"' : ''} alt="" loading="${idx === 0 ? 'eager' : 'lazy'}" /></div>`;
        const buildThumb = (src: string, idx: number) =>
          `<div class="swiper-slide${idx === 0 ? ' is-active swiper-slide-thumb-active' : ''}"><img src="${src}" alt="" loading="lazy" /></div>`;

        const mainWrapper = galleryRoot.querySelector('.swiper-wrapper');
        const thumbsEl = document.querySelector('.product-single-gallery-thumbs');
        const thumbsWrapper = thumbsEl?.querySelector('.swiper-wrapper');

        if (mainWrapper) {
          mainWrapper.innerHTML = images.map((img, i) => buildSlide(img, i)).join('');
        }
        if (thumbsWrapper && images.length > 1) {
          thumbsWrapper.innerHTML = images.map((img, i) => buildThumb(img, i)).join('');
        }

        if (typeof (window as any).initProductSingleGallery === 'function') {
          (window as any).initProductSingleGallery();
        } else {
          document.dispatchEvent(new CustomEvent('productsingle:gallery-updated'));
        }
        return;
      }

      // Fastkart 模板：.product-main + .left-slider-image（slick 与 custom_slick.js 一致）
      const fkMain = document.querySelector('.product-main');
      const fkThumb = document.querySelector('.left-slider-image');
      if (fkMain && fkThumb) {
        const buildSlide = (src: string, idx: number) =>
          `<div><div class="slider-image"><img src="${src}" data-zoom-image="${src}" class="img-fluid image_zoom_cls-${idx} blur-up lazyload" alt=""></div></div>`;
        const buildThumb = (src: string) =>
          `<div><div class="sidebar-image"><img src="${src}" class="img-fluid blur-up lazyload" alt=""></div></div>`;
        fkMain.innerHTML = images.map((img, i) => buildSlide(img, i)).join('');
        fkThumb.innerHTML = images.map((img) => buildThumb(img)).join('');
        const w = window as any;
        if (w.jQuery && w.jQuery.fn && w.jQuery.fn.slick) {
          const $ = w.jQuery;
          const $pm = $('.product-main');
          const $th = $('.left-slider-image');
          if ($pm.hasClass('slick-initialized')) $pm.slick('unslick');
          if ($th.hasClass('slick-initialized')) $th.slick('unslick');
          $pm.slick({
            slidesToShow: 1,
            slidesToScroll: 1,
            arrows: false,
            fade: true,
            asNavFor: '.left-slider-image',
          });
          $th.slick({
            slidesToShow: 4,
            slidesToScroll: 1,
            asNavFor: '.product-main',
            dots: false,
            focusOnSelect: true,
            responsive: [
              { breakpoint: 1400, settings: { vertical: false } },
              { breakpoint: 992, settings: { vertical: false } },
              { breakpoint: 768, settings: { vertical: false } },
              { breakpoint: 430, settings: { slidesToShow: 3, vertical: false } },
            ],
          });
        }
        return;
      }

      // SVG图标（用于图片预览）
      const svgIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M6.8885 8.61157C6.7605 8.61157 6.6325 8.66057 6.535 8.75807L2.5 12.7936V10.4651C2.5 10.1886 2.2765 9.96507 2 9.96507C1.7235 9.96507 1.5 10.1886 1.5 10.4651V14.0001C1.5 14.2766 1.7235 14.5001 2 14.5001H5.535C5.8115 14.5001 6.035 14.2766 6.035 14.0001C6.035 13.7236 5.8115 13.5001 5.535 13.5001H3.2075L7.242 9.46507C7.4375 9.26957 7.4375 8.95357 7.242 8.75807C7.1445 8.66007 7.0165 8.61157 6.8885 8.61157Z" fill="black" />
        <path d="M14.0555 1.55554H10.5205C10.244 1.55554 10.0205 1.77904 10.0205 2.05554C10.0205 2.33204 10.244 2.55554 10.5205 2.55554H12.8485L8.75753 6.64654C8.56203 6.84204 8.56203 7.15804 8.75753 7.35354C8.95303 7.54904 9.26903 7.54904 9.46453 7.35354L13.5555 3.26254V5.59054C13.5555 5.86704 13.779 6.09054 14.0555 6.09054C14.332 6.09054 14.5555 5.86704 14.5555 5.59054V2.05554C14.5555 1.77954 14.332 1.55554 14.0555 1.55554Z" fill="black" />
      </svg>`;

      // 渲染移动端轮播（Swiper）
      const mobileContainer = document.querySelector('.swiper-container.one-grid-bullet-slider');
      const mobileWrapper = document.querySelector('.swiper-wrapper.shop-left-content');
      
      if (mobileWrapper && mobileContainer) {
        // 构建移动端轮播HTML
        let mobileHTML = '';
        images.forEach((img, index) => {
          const isFirst = index === 0;
          mobileHTML += `
            <div class="swiper-slide">
              <div class="img ${isFirst ? 'overflow-visible' : ''} position-relative">
                ${isFirst ? '<div class="overflow-hidden">' : ''}
                  <img src="${img}" alt="shop-img" class="img-fluid w-100">
                ${isFirst ? '</div>' : ''}
                <a href="${img}" class="view-shop-item popup-img position-absolute bg-white rounded-pill d-flex justify-content-center align-items-center">
                  ${svgIcon}
                </a>
                ${isFirst ? '<a href="#get-look" class="go-down bg-transparent border-0 position-absolute">SCROLL</a>' : ''}
              </div>
            </div>
          `;
        });
        mobileWrapper.innerHTML = mobileHTML;

        // 重新初始化移动端 Swiper
        // 注意：需要确保 Swiper 已经加载
        if (typeof (window as any).Swiper !== 'undefined') {
          // 销毁已存在的实例
          const existingSwiper = (mobileContainer as any).swiper;
          if (existingSwiper) {
            existingSwiper.destroy(true, true);
          }

          // 重新初始化
          new (window as any).Swiper(mobileContainer, {
            slidesPerView: 1,
            spaceBetween: 0,
            loop: images.length > 1,
            autoplay: images.length > 1,
            speed: 600,
            effect: "fade",
            pagination: {
              el: mobileContainer.querySelector('.swiper-pagination'),
              clickable: true,
            },
          });
        }
      }

      // 渲染桌面端图片（非轮播，垂直排列）
      const desktopWrapper = document.querySelector('.shop-left-content.d-none.d-lg-block');
      if (desktopWrapper) {
        let desktopHTML = '';
        images.forEach((img, index) => {
          const isFirst = index === 0;
          desktopHTML += `
            <div class="img ${isFirst ? 'overflow-visible' : ''} position-relative">
              ${isFirst ? '<div class="overflow-hidden">' : ''}
                <img src="${img}" alt="shop-img" class="img-fluid w-100">
              ${isFirst ? '</div>' : ''}
              <a href="${img}" class="view-shop-item popup-img position-absolute bg-white rounded-pill d-flex justify-content-center align-items-center">
                ${svgIcon}
              </a>
              ${isFirst ? '<a href="#get-look" class="go-down bg-transparent border-0 position-absolute">SCROLL</a>' : ''}
            </div>
          `;
        });
        desktopWrapper.innerHTML = desktopHTML;
      }

      // 重新初始化 magnificPopup（用于图片轮播预览）
      // 因为图片是动态生成的，需要重新绑定 popup-img 事件
      if (typeof (window as any).jQuery !== 'undefined' && (window as any).jQuery.fn.magnificPopup) {
        const $ = (window as any).jQuery;
        // 销毁已存在的实例（如果有）
        $('.popup-img').each(function(index: number, element: HTMLElement) {
          const $this = $(element);
          if ($this.data('magnificPopup')) {
            $this.magnificPopup('destroy');
          }
        });
        
        // 重新初始化 magnificPopup
        $('.popup-img').magnificPopup({
          type: 'image',
          gallery: {
            enabled: true,
          }
        });
        console.log('magnificPopup 已重新初始化');
      }
    }

    // 渲染产品价格（初始渲染，使用产品主数据或默认变体）
    function renderProductPrice(
      articleMain: ArticleMainData,
      variants: ArticleVariantsData,
      discountRules: DiscountRulesData,
      config: ReturnType<typeof getGlobalConfig>
    ) {
      // 如果有变体和属性，尝试找到默认选中的变体
      if (variants.data.variants && variants.data.variants.length > 0 && 
          variants.data.attributes && variants.data.attributes.length > 0) {
        const selectedAttributes = getSelectedAttributes();
        const matchedVariant = clientVariant.findVariantByAttributes(
          selectedAttributes,
          variants.data.variants,
          variants.data.attributes
        );

        if (matchedVariant) {
          // 使用变体的价格
          updatePriceWithVariant(matchedVariant, discountRules, config);
          return;
        }
      }

      // 否则使用产品主数据的价格
      updatePriceWithArticle(articleMain, discountRules, config);
    }

    // 渲染产品库存（初始渲染，使用产品主数据或默认变体）
    function renderProductStock(
      articleMain: ArticleMainData,
      variants: ArticleVariantsData
    ) {
      // 如果有变体和属性，尝试找到默认选中的变体
      if (variants.data.variants && variants.data.variants.length > 0 &&
          variants.data.attributes && variants.data.attributes.length > 0) {
        const selectedAttributes = getSelectedAttributes();
        const matchedVariant = clientVariant.findVariantByAttributes(
          selectedAttributes,
          variants.data.variants,
          variants.data.attributes
        );

        if (matchedVariant) {
          // 使用变体的库存
          updateStockWithVariant(matchedVariant);
          return;
        }
      }

      // 否则使用产品主数据的库存
      updateStockWithArticle(articleMain);
    }

    // 获取折扣规则的多语言显示名称
    function getDiscountDisplayName(discount: Discount, locale: string): string {
      // 优先使用翻译
      if (discount.translations && discount.translations.length > 0) {
        const translation = discount.translations.find(t => t.language_code === locale);
        if (translation && (translation as any).rule_name) {
          return (translation as any).rule_name;
        }
      }
      // 返回默认名称
      return discount.rule_name || discount.rule_code || '折扣';
    }

    // 渲染折扣规则列表
    function renderDiscountRules(
      discountRules: DiscountRulesData,
      locale: string
    ) {
      const discounts = discountRules.data.discounts || [];
      const viewer = getDiscountViewerContext();
      const activeDiscounts = discounts.filter(
        (d) =>
          d.status === 'active' && matchesDiscountUserRestrictions(d, viewer)
      );

      const outer = document.getElementById('discount-rules-outer');
      const discountListContainer = document.querySelector('#discount-rules-list');
      if (!discountListContainer) {
        return;
      }

      if (activeDiscounts.length === 0) {
        discountListContainer.innerHTML = '';
        if (outer) {
          outer.style.display = 'none';
        }
        return;
      }

      discountListContainer.innerHTML = '';
      if (outer) {
        outer.style.display = 'block';
      }

      activeDiscounts.forEach((discount) => {
        const discountName = getDiscountDisplayName(discount, locale);
        const displayName = discountName.length > 15
          ? `${discountName.substring(0, 15)}…`
          : discountName;

        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className =
          'product-discount-chip btn btn-sm btn-outline-danger rounded-pill';
        chip.setAttribute('aria-label', discountName);
        chip.title = discountName;

        const icon = document.createElement('i');
        icon.className = 'fa fa-tag me-1';
        icon.setAttribute('aria-hidden', 'true');
        chip.appendChild(icon);

        const span = document.createElement('span');
        span.textContent = displayName;
        chip.appendChild(span);

        chip.addEventListener('click', () => {
          openDiscountModal(discount, locale);
        });

        discountListContainer.appendChild(chip);
      });
    }

    // 打开折扣规则详情弹窗
    function openDiscountModal(discount: Discount, locale: string) {
      const modal = document.getElementById('discount-modal');
      const overlay = document.getElementById('discount-modal-overlay');
      const modalTitle = document.getElementById('discount-modal-title');
      const modalContent = document.getElementById('discount-modal-content');
      
      if (!modal || !overlay || !modalTitle || !modalContent) {
        return;
      }

      // 设置标题
      modalTitle.textContent = getDiscountDisplayName(discount, locale);

      const cfgDisc = getGlobalConfig();
      if (isUnregisteredPriceUiHidden(cfgDisc.tenantId, productCategoryIdsForDiscount)) {
        modalContent.innerHTML = `<p class="mb-0 text-content">${clientTranslations.get('price_login_to_view' as any)}</p>`;
        modal.style.display = 'block';
        overlay.style.display = 'block';
        bindDiscountModalCloseEvents();
        return;
      }

      // 生成内容
      modalContent.innerHTML = generateDiscountModalContent(discount, locale);

      // 显示弹窗
      modal.style.display = 'block';
      overlay.style.display = 'block';

      // 绑定关闭事件
      bindDiscountModalCloseEvents();
    }

    function tDiscount(key: string, vars?: Record<string, string | number>): string {
      let s = clientTranslations.get(key as any);
      if (vars) {
        for (const [k, v] of Object.entries(vars)) {
          s = s.replace(new RegExp(`\\{${k}\\}`, 'g'), String(v));
        }
      }
      return s;
    }

    function discountKindLabel(discountType: string): string {
      const m: Record<string, string> = {
        percentage: 'discount_kind_percentage',
        fixed_amount: 'discount_kind_fixed_amount',
        tier_price: 'discount_kind_tier_price',
      };
      const trKey = m[discountType];
      return trKey ? tDiscount(trKey) : discountType;
    }

    function discountRuleKindLabel(ruleType: string): string {
      const m: Record<string, string> = {
        quantity: 'discount_rule_kind_quantity',
        user_level: 'discount_rule_kind_user_level',
        time_based: 'discount_rule_kind_time_based',
        product_based: 'discount_rule_kind_product_based',
        combo: 'discount_rule_kind_combo',
      };
      const trKey = m[ruleType];
      return trKey ? tDiscount(trKey) : ruleType;
    }

    function tierPriceTypeLabel(priceType: string): string {
      if (priceType === 'percentage') {
        return tDiscount('discount_kind_percentage');
      }
      if (priceType === 'fixed_amount') {
        return tDiscount('discount_kind_fixed_amount');
      }
      if (priceType === 'absolute_price') {
        return tDiscount('discount_kind_absolute_price');
      }
      return priceType;
    }

    // 生成折扣规则详情内容（文案走 clientTranslations / 当前 __ASTRO_LOCALE__）
    function generateDiscountModalContent(discount: Discount, locale: string): string {
      let html = '';

      const discountTypeName = discountKindLabel(discount.discount_type);
      const ruleTypeName = discountRuleKindLabel(discount.rule_type);

      html += `<div class="mb-3">`;
      html += `<p class="mb-2"><strong>${tDiscount('discount_modal_lbl_discount_type')}</strong>${discountTypeName}</p>`;
      html += `<p class="mb-2"><strong>${tDiscount('discount_modal_lbl_rule_type')}</strong>${ruleTypeName}</p>`;
      html += `<p class="mb-2"><strong>${tDiscount('discount_modal_lbl_priority')}</strong>${discount.priority}</p>`;
      html += `</div>`;

      if (discount.discount_type !== 'tier_price' && discount.discount_value > 0) {
        html += `<div class="mb-3">`;
        if (discount.discount_type === 'percentage') {
          html += `<p class="mb-0"><strong>${tDiscount('discount_modal_lbl_strength')}</strong>${(discount.discount_value * 100).toFixed(0)}%</p>`;
        } else if (discount.discount_type === 'fixed_amount') {
          html += `<p class="mb-0"><strong>${tDiscount('discount_modal_lbl_amount_off')}</strong>${discount.discount_value}</p>`;
        }
        html += `</div>`;
      }

      if (discount.quantity_restrictions) {
        const { min_quantity, max_quantity } = discount.quantity_restrictions;
        const parts: string[] = [];
        if (min_quantity !== null && min_quantity !== undefined) {
          parts.push(tDiscount('discount_modal_min_units', { n: min_quantity }));
        }
        if (max_quantity !== null && max_quantity !== undefined) {
          parts.push(tDiscount('discount_modal_max_units', { n: max_quantity }));
        }
        html += `<div class="mb-3">`;
        html += `<p class="mb-0"><strong>${tDiscount('discount_modal_lbl_quantity_limits')}</strong>`;
        if (parts.length === 0) {
          html += tDiscount('discount_modal_no_limit');
        } else {
          html += parts.join(' · ');
        }
        html += `</p></div>`;
      }

      if (discount.amount_restrictions) {
        const { min_amount, max_amount } = discount.amount_restrictions;
        const parts: string[] = [];
        if (min_amount !== null && min_amount !== undefined) {
          parts.push(tDiscount('discount_modal_min_amount_val', { amount: min_amount }));
        }
        if (max_amount !== null && max_amount !== undefined) {
          parts.push(tDiscount('discount_modal_max_amount_val', { amount: max_amount }));
        }
        html += `<div class="mb-3">`;
        html += `<p class="mb-0"><strong>${tDiscount('discount_modal_lbl_amount_limits')}</strong>`;
        if (parts.length === 0) {
          html += tDiscount('discount_modal_no_limit');
        } else {
          html += parts.join(' · ');
        }
        html += `</p></div>`;
      }

      if (discount.time_restrictions) {
        const { valid_from, valid_until } = discount.time_restrictions;
        const fmt = (iso: string) => new Date(iso).toLocaleString(locale.replace('_', '-'));
        let periodText = '';
        if (valid_from && valid_until) {
          periodText = tDiscount('discount_modal_valid_range', { from: fmt(valid_from), to: fmt(valid_until) });
        } else if (valid_from) {
          periodText = tDiscount('discount_modal_valid_from', { from: fmt(valid_from) });
        } else if (valid_until) {
          periodText = tDiscount('discount_modal_valid_until', { until: fmt(valid_until) });
        } else {
          periodText = tDiscount('discount_modal_time_forever');
        }
        html += `<div class="mb-3">`;
        html += `<p class="mb-0"><strong>${tDiscount('discount_modal_lbl_valid_time')}</strong>${periodText}</p>`;
        html += `</div>`;
      }

      if (discount.discount_type === 'tier_price' && discount.tier_prices && discount.tier_prices.length > 0) {
        const activeTierPrices = discount.tier_prices.filter(
          (tp) => !tp.status || tp.status === 'active'
        );
        if (activeTierPrices.length > 0) {
          html += `<div class="mb-3">`;
          html += `<p class="mb-2"><strong>${tDiscount('discount_modal_lbl_tier_prices')}</strong></p>`;
          html += `<table class="table table-bordered table-sm">`;
          html += `<thead><tr><th>${tDiscount('discount_modal_th_qty_range')}</th><th>${tDiscount('discount_modal_th_price_type')}</th><th>${tDiscount('discount_modal_th_price_value')}</th></tr></thead>`;
          html += `<tbody>`;

          activeTierPrices.sort((a, b) => a.sort_order - b.sort_order);

          activeTierPrices.forEach((tier) => {
            const minQty = tier.min_quantity ?? 0;
            const maxQtyRaw = tier.max_quantity;
            const maxQty =
              maxQtyRaw !== null && maxQtyRaw !== undefined
                ? maxQtyRaw
                : tDiscount('discount_modal_qty_infinity');
            const quantityRange = `${minQty} - ${maxQty}`;

            const priceTypeText = tierPriceTypeLabel(tier.price_type);
            let priceValueText = '';
            if (tier.price_type === 'percentage') {
              priceValueText = `${(tier.price_value * 100).toFixed(0)}%`;
            } else {
              priceValueText = tier.price_value.toString();
            }

            html += `<tr>`;
            html += `<td>${quantityRange}</td>`;
            html += `<td>${priceTypeText}</td>`;
            html += `<td>${priceValueText}</td>`;
            html += `</tr>`;
          });

          html += `</tbody></table>`;
          html += `</div>`;
        }
      }

      if (discount.usage_restrictions) {
        const { usage_limit, usage_count, per_user_limit } = discount.usage_restrictions;
        html += `<div class="mb-3">`;
        html += `<p class="mb-1"><strong>${tDiscount('discount_modal_lbl_usage_limits')}</strong></p>`;
        if (usage_limit !== null && usage_limit !== undefined) {
          html += `<p class="mb-1">${tDiscount('discount_modal_usage_total', {
            limit: usage_limit,
            used: usage_count || 0,
          })}</p>`;
        }
        if (per_user_limit !== null && per_user_limit !== undefined) {
          html += `<p class="mb-0">${tDiscount('discount_modal_usage_per_user', { limit: per_user_limit })}</p>`;
        }
        if (
          (usage_limit === null || usage_limit === undefined) &&
          (per_user_limit === null || per_user_limit === undefined)
        ) {
          html += `<p class="mb-0">${tDiscount('discount_modal_usage_none')}</p>`;
        }
        html += `</div>`;
      }

      return html;
    }

    // 绑定折扣弹窗关闭事件
    function bindDiscountModalCloseEvents() {
      const modal = document.getElementById('discount-modal');
      const overlay = document.getElementById('discount-modal-overlay');
      const closeBtn = document.getElementById('discount-modal-close');
      
      const closeModal = () => {
        if (modal) {
          modal.style.display = 'none';
        }
        if (overlay) {
          overlay.style.display = 'none';
        }
      };

      if (closeBtn) {
        closeBtn.onclick = closeModal;
      }
      
      if (overlay) {
        overlay.onclick = closeModal;
      }
    }

    // 判断属性是否是颜色属性
    function isColorAttribute(attribute: Attribute): boolean {
      // 检查属性值是否有 color_code，或者通过属性代码/名称判断
      if (attribute.values && attribute.values.length > 0) {
        // 如果有任何一个属性值有 color_code，则认为是颜色属性
        return attribute.values.some((value: AttributeValue) => !!value.color_code);
      }
      // 也可以通过属性代码判断（如 "color", "colour" 等）
      const code = (attribute.attribute_code || '').toLowerCase();
      const name = (attribute.attribute_name || '').toLowerCase();
      return code.includes('color') || code.includes('colour') || name.includes('颜色') || name.includes('colour') || name.includes('color');
    }

    // 隐藏属性容器（当没有属性时调用）
    function hideAttributeContainers() {
      const colorContainer = document.querySelector('.color-plates');
      const sizeContainer = document.querySelector('.shop-sizes');
      if (colorContainer) {
        (colorContainer as HTMLElement).style.display = 'none';
      }
      if (sizeContainer) {
        (sizeContainer as HTMLElement).style.display = 'none';
      }
    }

    // 渲染产品属性（颜色、尺寸等）
    function renderProductAttributes(
      variants: ArticleVariantsData,
      locale: string
    ) {
      const attributes = variants.data.attributes || [];
      if (attributes.length === 0) {
        // 如果没有属性，隐藏属性容器
        hideAttributeContainers();
        return;
      }

      // 查找颜色属性容器和尺寸属性容器
      const colorContainer = document.querySelector('.color-plates');
      const sizeContainerWrapper = document.querySelector('.shop-sizes') as HTMLElement;

      // 分离颜色属性和普通属性
      const colorAttributes = attributes.filter(attr => isColorAttribute(attr));
      const normalAttributes = attributes.filter(attr => !isColorAttribute(attr));

      console.log('=== 属性渲染调试信息 ===');
      console.log('颜色属性数量:', colorAttributes.length);
      console.log('普通属性数量:', normalAttributes.length);
      console.log('所有属性:', attributes.map(a => ({ 
        code: a.attribute_code, 
        name: a.display_name, 
        valuesCount: a.values.length,
        values: a.values.map(v => ({ id: v.id, code: v.value_code, name: v.display_name }))
      })));

      // 渲染颜色属性（只渲染第一个）
      if (colorAttributes.length > 0 && colorContainer) {
        const attribute = colorAttributes[0];
        const attributeDisplayName = clientVariant.getAttributeDisplayName(attribute, locale);
        renderColorAttribute(attribute, attributeDisplayName, locale, colorContainer);
        (colorContainer as HTMLElement).style.display = '';
      } else if (colorContainer) {
        // 如果没有颜色属性，隐藏颜色容器
        (colorContainer as HTMLElement).style.display = 'none';
      }

      // 渲染所有普通属性
      if (normalAttributes.length > 0 && sizeContainerWrapper) {
        // 先保存按钮和其他元素（如果存在），避免被清空时删除
        const guideButton = sizeContainerWrapper.querySelector('.guide-btn.cloth-size-btn');
        const guideButtonHTML = guideButton ? guideButton.outerHTML : '';
        const sidebarOverlay = sizeContainerWrapper.querySelector('.cloth-sidebar-overlay');
        const sidebarOverlayHTML = sidebarOverlay ? sidebarOverlay.outerHTML : '';
        const clothSidebar = sizeContainerWrapper.querySelector('.cloth-size-sidebar');
        const clothSidebarHTML = clothSidebar ? clothSidebar.outerHTML : '';
        
        // 设置容器样式，使多个属性容器能够自动分行（垂直排列）
        sizeContainerWrapper.style.flexDirection = 'column';
        sizeContainerWrapper.style.flexWrap = 'nowrap';
        sizeContainerWrapper.style.alignItems = 'flex-start';
        sizeContainerWrapper.style.gap = '30px'; // 保持原有的gap-3间距
        
        // 清空包装容器，准备重新渲染
        sizeContainerWrapper.innerHTML = '';
        
        // 普通属性：radio + label 药丸样式（与项目 Tailwind 模板一致）
        normalAttributes.forEach((attribute) => {
          const attributeDisplayName = clientVariant.getAttributeDisplayName(attribute, locale);

          const pkg = document.createElement('div');
          pkg.className = 'product-attribute-group mb-4';
          pkg.setAttribute('data-attribute-id', attribute.id);

          const titleWrap = document.createElement('div');
          titleWrap.className = 'product-attribute-group__title text-tagline-2 mb-2 font-medium';
          titleWrap.textContent = attributeDisplayName;

          const optionsWrap = document.createElement('div');
          optionsWrap.className = 'product-attribute-options flex flex-wrap gap-2';

          attribute.values.forEach((value: AttributeValue, valueIndex: number) => {
            const displayName = clientVariant.getAttributeValueDisplayName(value, locale);
            const inputId = `attr-${attribute.id}-${value.id}`;

            const label = document.createElement('label');
            label.className = 'product-attribute-option';
            label.htmlFor = inputId;

            const input = document.createElement('input');
            input.type = 'radio';
            input.name = `attribute-${attribute.id}`;
            input.id = inputId;
            input.className = 'product-attribute-option__input';
            input.value = value.id;
            input.setAttribute('data-attribute-id', attribute.id);
            input.setAttribute('data-attribute-value-id', value.id);
            if (valueIndex === 0) {
              input.checked = true;
            }

            input.addEventListener('change', () => {
              handleAttributeChange(attribute.id, value.id);
            });

            const text = document.createElement('span');
            text.className = 'product-attribute-option__text';
            text.textContent = displayName;

            label.appendChild(input);
            label.appendChild(text);
            optionsWrap.appendChild(label);
          });

          pkg.appendChild(titleWrap);
          pkg.appendChild(optionsWrap);
          sizeContainerWrapper.appendChild(pkg);
        });
        
        // 恢复按钮和其他元素（如果存在）
        if (guideButtonHTML) {
          const tempDiv = document.createElement('div');
          tempDiv.innerHTML = guideButtonHTML;
          const restoredButton = tempDiv.firstElementChild as HTMLElement;
          if (restoredButton) {
            sizeContainerWrapper.appendChild(restoredButton);
          }
        }
        if (sidebarOverlayHTML) {
          const tempDiv = document.createElement('div');
          tempDiv.innerHTML = sidebarOverlayHTML;
          const restoredOverlay = tempDiv.firstElementChild as HTMLElement;
          if (restoredOverlay) {
            sizeContainerWrapper.appendChild(restoredOverlay);
          }
        }
        if (clothSidebarHTML) {
          const tempDiv = document.createElement('div');
          tempDiv.innerHTML = clothSidebarHTML;
          const restoredSidebar = tempDiv.firstElementChild as HTMLElement;
          if (restoredSidebar) {
            sizeContainerWrapper.appendChild(restoredSidebar);
          }
