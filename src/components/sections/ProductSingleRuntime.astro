    // 渲染颜色属性
    function renderColorAttribute(
      attribute: Attribute,
      attributeDisplayName: string,
      locale: string,
      container: Element
    ) {
      // 更新标题
      const titleElement = container.querySelector('.color-title');
      if (titleElement) {
        const activeSpan = titleElement.querySelector('.active');
        if (activeSpan) {
          activeSpan.textContent = ''; // 初始时没有选中项
        }
        titleElement.innerHTML = `${attributeDisplayName}: <span class="active"></span>`;
      }

      // 渲染颜色选择器
      const colorOptionsContainer =
        container.querySelector('.product-attribute-options') ||
        container.querySelector('.d-flex.align-items-center.gap-2');
      if (colorOptionsContainer) {
        colorOptionsContainer.innerHTML = '';
        
        attribute.values.forEach((value: AttributeValue, index: number) => {
          const displayName = clientVariant.getAttributeValueDisplayName(value, locale);
          const colorCode = value.color_code;
          const inputId = `color-${attribute.id}-${value.id}`;

          const label = document.createElement('label');
          label.className = colorCode ? 'product-color-swatch' : 'product-attribute-option';
          label.htmlFor = inputId;
          label.title = displayName;

          const input = document.createElement('input');
          input.type = 'radio';
          input.name = `color-${attribute.id}`;
          input.id = inputId;
          input.className = colorCode
            ? 'product-color-swatch__input'
            : 'product-attribute-option__input';
          input.value = value.id;
          input.setAttribute('data-attribute-id', attribute.id);
          input.setAttribute('data-attribute-value-id', value.id);

          if (colorCode) {
            label.className = 'product-color-swatch product-color-swatch--labeled';
            const dot = document.createElement('span');
            dot.className = 'product-color-swatch__dot';
            dot.style.backgroundColor = colorCode;
            const text = document.createElement('span');
            text.className = 'product-color-swatch__label';
            text.textContent = displayName;
