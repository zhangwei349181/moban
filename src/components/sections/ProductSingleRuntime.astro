    // 渲染价格显示（原价和折扣价格）
    function renderPriceDisplay(
      originalPrice: number,
      discountedPrice: number,
      hasDiscount: boolean,
      currency: any
    ) {
      console.log('=== 价格显示渲染调试 ===');
      console.log('原价:', originalPrice);
      console.log('折扣价格:', discountedPrice);
      console.log('hasDiscount:', hasDiscount);
      console.log('discountedPrice < originalPrice:', discountedPrice < originalPrice);
      console.log('货币:', currency);

      const fkCfg = getGlobalConfig();
      const fkPriceEl = document.querySelector('.price-rating .price') as HTMLElement | null;
      if (isUnregisteredPriceUiHidden(fkCfg.tenantId, productCategoryIdsForDiscount)) {
        const msg = clientTranslations.get('price_login_to_view' as any);
        const stockStr = `<span class="offer theme-color">(<span class="text-muted">${clientTranslations.get('stock')}: </span><span class="fk-stock-value">0</span>)</span>`;
        if (fkPriceEl) {
          fkPriceEl.innerHTML = `<span class="text-content">${msg}</span> ${stockStr}`;
        }
        return;
      }

      const shouldShowDiscount = hasDiscount && discountedPrice < originalPrice;
      const showPrice = shouldShowDiscount ? discountedPrice : originalPrice;
      if (fkPriceEl) {
        const stockStr = `<span class="offer theme-color">(<span class="text-muted">${clientTranslations.get('stock')}: </span><span class="fk-stock-value">0</span>)</span>`;
        if (currency) {
          const main = clientPricing.formatPrice(showPrice, currency);
          if (shouldShowDiscount) {
            const orig = clientPricing.formatPrice(originalPrice, currency);
            fkPriceEl.innerHTML = `<span class="text-decoration-line-through text-muted me-2">${orig}</span><span>${main}</span> ${stockStr}`;
          } else {
            fkPriceEl.innerHTML = `${main} ${stockStr}`;
          }
        } else {
          fkPriceEl.innerHTML = `${showPrice.toFixed(2)} ${stockStr}`;
        }
        return;
      }

      const originalPriceElement = document.querySelector('.original-price-value');
      const originalPriceLabel = document.querySelector('.original-price-label');
      const discountedPriceElement = document.querySelector('.discounted-price');
      const discountedPriceLabel = document.querySelector('.discounted-price-label');
      const discountedPriceValueElement = document.querySelector('.discounted-price-value');

      if (!originalPriceElement || !discountedPriceElement || !discountedPriceValueElement) {
        console.error('价格显示元素未找到:', {
          originalPriceElement: !!originalPriceElement,
          discountedPriceElement: !!discountedPriceElement,
          discountedPriceValueElement: !!discountedPriceValueElement
        });
        return;
      }

      // 更新原价标签（国际化）
      if (originalPriceLabel) {
        originalPriceLabel.textContent = clientTranslations.get('original_price');
      }

      // 显示原价
      if (currency) {
        const formattedOriginalPrice = clientPricing.formatPrice(originalPrice, currency);
        (originalPriceElement as HTMLElement).textContent = formattedOriginalPrice;
        console.log('格式化原价:', formattedOriginalPrice);
      } else {
        (originalPriceElement as HTMLElement).textContent = originalPrice.toFixed(2);
      }

      // 如果有折扣，显示折扣价格；否则隐藏折扣价格（与上方 Fastkart 分支共用 shouldShowDiscount）
      console.log('是否显示折扣价格:', shouldShowDiscount);
      
      if (shouldShowDiscount) {
        // 更新折扣价格标签（国际化）
        if (discountedPriceLabel) {
          discountedPriceLabel.textContent = clientTranslations.get('discounted_price');
        }

        if (currency) {
          const formattedDiscountedPrice = clientPricing.formatPrice(discountedPrice, currency);
          (discountedPriceValueElement as HTMLElement).textContent = formattedDiscountedPrice;
          console.log('格式化折扣价格:', formattedDiscountedPrice);
        } else {
          (discountedPriceValueElement as HTMLElement).textContent = discountedPrice.toFixed(2);
        }
        (discountedPriceElement as HTMLElement).style.display = '';
        console.log('折扣价格元素已显示');
      } else {
        (discountedPriceElement as HTMLElement).style.display = 'none';
        console.log('折扣价格元素已隐藏');
      }
    }

