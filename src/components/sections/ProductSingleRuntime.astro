    /** 愿望清单：与 list01 共用 localStorage wishlist_product_ids */
    function initWishlistButton() {
      const btnEl = document.getElementById('product-wishlist-btn');
      if (!(btnEl instanceof HTMLAnchorElement)) {
        return;
      }
      const btn = btnEl;
      const productId = btn.dataset.productId ?? getArticleId() ?? '';
      if (!productId) {
        return;
      }

      const labelEl = document.getElementById('product-wishlist-label');

      function syncWishlistUi() {
        const on = isInWishlist(productId);
        btn.style.color = on ? '#dc3545' : '';
        if (labelEl) {
          labelEl.textContent = on
            ? clientTranslations.get('remove_from_wishlist')
            : clientTranslations.get('add_to_wishlist');
        }
      }

      syncWishlistUi();

      btn.addEventListener('click', (e: Event) => {
        e.preventDefault();
        toggleWishlist(productId);
        syncWishlistUi();
      });
    }

    // 处理添加到购物车
    async function handleAddToCart() {
      console.log('=== 添加到购物车 ===');

      if (!isAuthenticated()) {
        alert(clientTranslations.get('please_login_first'));
        return;
      }

      // 1. 验证没有错误状态
      if (hasShippingTaxError()) {
        const errorState = getShippingTaxErrorState();
        console.error('无法添加到购物车，运费税费计算有错误:', errorState);
        alert(errorState.message || '运费和税费计算有错误，请先解决后再添加购物车');
        return;
      }

      // 2. 验证必要数据
      if (!globalProductData || !currentPriceInfo) {
        console.error('产品数据或价格信息未初始化');
        alert('产品数据未加载完成，请稍后再试');
        return;
      }

      const { articleMain, articleContent, config } = globalProductData;
      const quantity = getCurrentQuantity();

      if (
        selectedGroupBuying &&
        !matchesGroupBuyingUserRestrictions(selectedGroupBuying, getDiscountViewerContext())
      ) {
        alert(clientTranslations.get('group_buying_not_eligible'));
        return;
      }

      if (
        selectedCrowdfunding &&
        !matchesCrowdfundingUserRestrictions(selectedCrowdfunding, getDiscountViewerContext())
      ) {
        alert(clientTranslations.get('crowdfunding_not_eligible'));
        return;
      }

      // 3. 验证数量小于库存
      let availableStock: number | null = null; // null 表示无限库存
      if (selectedGroupBuying) {
        // 如果已选择团购，使用团购库存
        // 如果总库存不存在，表示库存无限，不需要检查
        if (selectedGroupBuying.inventory_config.total_inventory === null || 
            selectedGroupBuying.inventory_config.total_inventory === undefined) {
          // 总库存不存在，表示无限库存，跳过库存检查
          availableStock = null;
        } else {
          // 总库存存在，使用可用库存
          availableStock = selectedGroupBuying.inventory_config.available_inventory ?? 0;
        }
      } else if (currentVariant) {
        // 使用变体库存
        availableStock = currentVariant.inventory?.available_quantity || 0;
      } else {
        // 使用产品主数据库存
        availableStock = parseInt(
          articleMain.data.article.metadata.template_fields["in stock"] || '0'
        );
      }

      // 只有当库存不为null（即不是无限库存）时才进行库存检查
      if (availableStock !== null && quantity > availableStock) {
        console.error(`数量 ${quantity} 超过库存 ${availableStock}`);
        alert(`数量不能超过库存（当前库存：${availableStock}）`);
        return;
      }

      // 4. 获取选择的属性
      const selectedAttributes = getSelectedAttributes();
      const selectedAttributesMap: { [key: string]: string } = {};
      Object.keys(selectedAttributes).forEach(attrId => {
        selectedAttributesMap[attrId] = selectedAttributes[attrId];
      });

      // 5. 获取产品图片URL（使用第一个图片作为缩略图）
      const images = articleMain.data.article.metadata.template_fields["Showcase Gallery"] || [];
      const productImageUrl = images.length > 0 ? images[0] : '';

      // 6. 获取所有应用的折扣规则ID数组（支持折上折）
      const discountRuleIds = currentPriceInfo.discountResult?.appliedDiscounts?.map(
        (detail: AppliedDiscountDetail) => detail.discount?.id
      ).filter((id: string | undefined): id is string => !!id) || undefined;

      // 7. 判断当前货币是否是基础货币，如果不是则转换金额为基础货币
      const isBaseCurrency = config.defaultCurrency && config.currentCurrency && 
        (config.currentCurrency.is_base_currency || 
         config.currentCurrency.currency_code === config.defaultCurrency.currency_code);
      
      // 如果当前货币不是基础货币，需要将所有金额转换为基础货币（除以汇率）
      // exchangeRate 是从基础货币到当前货币的汇率，所以反向转换需要除以汇率
      const rawExchangeRate = config.exchangeRate || 1;
      const exchangeRateToBase = isBaseCurrency ? 1 : (rawExchangeRate > 0 ? rawExchangeRate : 1);
      
      const convertToBaseCurrency = (amount: number): number => {
        if (isBaseCurrency || exchangeRateToBase === 1) {
          return amount;
        }
        return amount / exchangeRateToBase;
      };

      // 转换所有金额字段为基础货币
      const unitPriceInBase = convertToBaseCurrency(currentPriceInfo.discountedPrice);
      const originalUnitPriceInBase = convertToBaseCurrency(currentPriceInfo.originalPrice);
      const discountAmountInBase = convertToBaseCurrency(currentPriceInfo.discountAmount);
      const shippingFeeInBase = convertToBaseCurrency(currentShippingTaxInfo?.shippingFee || 0);
      const taxFeeInBase = convertToBaseCurrency(currentShippingTaxInfo?.taxFee || 0);

      console.log('=== 货币转换调试 ===');
      console.log('当前货币:', config.currentCurrency?.currency_code);
      console.log('基础货币:', config.defaultCurrency?.currency_code);
      console.log('是否为基础货币:', isBaseCurrency);
      console.log('汇率（基础→当前）:', config.exchangeRate);
      console.log('转换后单价（基础货币）:', unitPriceInBase, '原值（当前货币）:', currentPriceInfo.discountedPrice);

      // currency_code 必须与静态 JSON 一致：有变体时用 variant.pricing.currency（服务端校验与此比对）；
      // 无变体时用店铺基础货币（与后端无变体分支一致）。
      const currencyCodeForCart =
        (currentVariant?.pricing?.currency && String(currentVariant.pricing.currency).trim()) ||
        config.defaultCurrency?.currency_code ||
        config.currentCurrency?.currency_code ||
        'USD';
      console.log('提交 currency_code:', currencyCodeForCart);

      // 8. 构建购物车项数据（所有金额字段使用基础货币）
      const cartItemData: Omit<import('../../lib/cart.js').CartItem, 'id' | 'added_at'> = {
        article_id: articleMain.data.article.id,
        variant_id: currentVariant?.id,
        selected_attributes: Object.keys(selectedAttributesMap).length > 0 ? selectedAttributesMap : undefined,
        quantity: quantity,
        unit_price: unitPriceInBase,
        original_unit_price: originalUnitPriceInBase,
        discount_amount: discountAmountInBase,
        shipping_fee: shippingFeeInBase,
        tax_fee: taxFeeInBase,
        shipping_address_id: selectedAddress?.id,
        shipping_template_id: currentShippingTaxInfo?.shippingTemplateId,
        tax_template_id: currentShippingTaxInfo?.taxTemplateId,
        // 额外字段
        article_type: articleMain.data.article.article_type,
        product_name: articleContent.data.title || '',
        product_sku: currentVariant?.sku,
        product_image_url: productImageUrl,
        discount_rule_ids: discountRuleIds,
        currency_code: currencyCodeForCart,
        group_buying_id: selectedGroupBuying?.id, // 如果参加了团购，包含团购活动ID
        crowdfunding_activity_id: selectedCrowdfunding?.id, // 如果参加了众筹，包含众筹活动ID
        crowdfunding_reward_id: matchedCrowdfundingReward?.id, // 如果参加了众筹，包含回报档位ID
      };

      // 9. 提交到服务端购物车（服务端重算单价/运费/税/库存；成功后 GET /cart 全量同步本地）
      try {
        await postAddCartItem(cartItemData);
        await syncLocalCartFromServer();
        alert('已添加到购物车');

        if (typeof (window as any).updateCartCount === 'function') {
          (window as any).updateCartCount();
        }

        if (typeof (window as any).renderMinicart === 'function') {
          (window as any).renderMinicart();
        }
      } catch (error) {
        console.error('添加到购物车失败:', error);
        const msg = error instanceof Error ? error.message : '添加到购物车失败，请稍后再试';
        alert(msg);
      }
    }

    // 获取运费模板的显示名称（支持多语言）
    function getShippingTemplateDisplayName(template: ShippingTemplateData, locale: string): string {
      if (!template || !template.data || !template.data.template) {
        return '';
      }

      // 根据文档，translations 在 data.translations 下
      // 如果指定了语言，查找翻译
      if (locale && template.data.translations && template.data.translations.length > 0) {
        const translation = template.data.translations.find(t => t.language_code === locale);
        if (translation && (translation as any).template_name) {
          return (translation as any).template_name;
        }
      }

      // 返回默认模板名称
      return template.data.template.template_name || '';
    }

    // 初始化运费模板选择器（提前定义，供initShippingTaxSummary调用）
    function initShippingTemplateSelector(shippingTemplates: ShippingTemplateData[], config: ReturnType<typeof getGlobalConfig>) {
      const templateSelector = document.getElementById('shipping-template-selector');
      const templateSelectEl = document.getElementById('shipping-template-select');

      if (!templateSelector || !(templateSelectEl instanceof HTMLSelectElement)) {
        return;
      }
      const templateSelect = templateSelectEl;

      // 显示选择器（注意：它已经被包装在 shipping-details-collapsible 中）
      // 不需要单独控制显示/隐藏，由父容器的折叠状态控制
      templateSelector.style.display = 'block';

      // 清空选项
      templateSelect.innerHTML = '';

      // 添加模板选项
      shippingTemplates.forEach((template, index) => {
        const option = document.createElement('option');
        option.value = index.toString();
        const displayName = getShippingTemplateDisplayName(template, config.locale);
        option.textContent = displayName || `模板 ${index + 1}`;
        if (index === 0) {
          option.selected = true;
          selectedShippingTemplateIndex = 0;
        }
        templateSelect.appendChild(option);
      });

      // 监听模板选择变化
      templateSelect.addEventListener('change', (e) => {
        const selectedIndex = parseInt((e.target as HTMLSelectElement).value, 10);
        if (!isNaN(selectedIndex) && selectedIndex >= 0 && selectedIndex < shippingTemplates.length) {
          selectedShippingTemplateIndex = selectedIndex;
          // 重新计算运费和税费
          if (selectedAddress && globalProductData) {
            calculateShippingAndTax();
          }
        }
      });

      // 绑定"查看运费规则"链接点击事件
      const viewRuleLink = document.getElementById('view-shipping-rule-link');
      if (viewRuleLink) {
        viewRuleLink.addEventListener('click', (e) => {
          e.preventDefault();
          handleViewShippingRule(config.locale);
        });
      }
    }

    // 处理查看运费规则
    function handleViewShippingRule(locale: string) {
      if (!globalProductData || !selectedAddress) {
        // 如果没有地址，提示用户
        alert(clientTranslations.get('select_shipping_address'));
        return;
      }

      const { shippingTemplates, regionsData } = globalProductData;
      
      // 获取当前选中的运费模板
      const shippingTemplate = shippingTemplates[selectedShippingTemplateIndex];
      if (!shippingTemplate || !regionsData || !regionsData.data) {
        return;
      }

      // 查找匹配的运费规则
      const matchedRule = clientShipping.findMatchingShippingRule(
        shippingTemplate.data.rules,
        selectedAddress.region_id,
        regionsData.data.regions
      );

      if (!matchedRule) {
        // 没有匹配的规则，显示提示
        const modal = document.getElementById('shipping-rule-modal');
        const overlay = document.getElementById('shipping-rule-modal-overlay');
        const modalTitle = document.getElementById('shipping-rule-modal-title');
        const modalContent = document.getElementById('shipping-rule-modal-content');
        
        if (modal && overlay && modalTitle && modalContent) {
          modalTitle.textContent = clientTranslations.get('shipping_template');
          modalContent.innerHTML = `<p class="text-muted">${clientTranslations.get('no_matching_shipping_rule')}</p>`;
          modal.style.display = 'block';
          overlay.style.display = 'block';
          bindShippingRuleModalCloseEvents();
        }
        return;
      }

      // 有匹配的规则，显示规则详情
      openShippingRuleModal(matchedRule, shippingTemplate, locale);
    }

    // 打开运费规则详情弹窗
    function openShippingRuleModal(
      rule: import('../../lib/product.js').ShippingRule,
      template: ShippingTemplateData,
      locale: string
    ) {
      const modal = document.getElementById('shipping-rule-modal');
      const overlay = document.getElementById('shipping-rule-modal-overlay');
      const modalTitle = document.getElementById('shipping-rule-modal-title');
      const modalContent = document.getElementById('shipping-rule-modal-content');
      
      if (!modal || !overlay || !modalTitle || !modalContent) {
        return;
      }

      // 设置标题
      modalTitle.textContent = rule.rule_name || clientTranslations.get('shipping_template');

      // 生成内容
      modalContent.innerHTML = generateShippingRuleModalContent(rule, template, locale);

      // 显示弹窗
      modal.style.display = 'block';
      overlay.style.display = 'block';

      // 绑定关闭事件
      bindShippingRuleModalCloseEvents();
    }

    // 生成运费规则详情内容
    function generateShippingRuleModalContent(
      rule: import('../../lib/product.js').ShippingRule,
      template: ShippingTemplateData,
      locale: string
    ): string {
      let html = '';

      // 规则类型说明（使用国际化）
      const ruleTypeMap: Record<string, string> = {
        'quantity': clientTranslations.get('shipping_rule_type_quantity'),
        'volume': clientTranslations.get('shipping_rule_type_volume'),
        'weight': clientTranslations.get('shipping_rule_type_weight'),
        'amount': clientTranslations.get('shipping_rule_type_amount'),
        'fixed': clientTranslations.get('shipping_rule_type_fixed'),
      };
      const ruleTypeName = ruleTypeMap[rule.rule_type] || rule.rule_type;

      // 基础信息
      html += `<div class="mb-3">`;
      html += `<p class="mb-2"><strong>${clientTranslations.get('shipping_rule_name')}</strong>${rule.rule_name || ''}</p>`;
      html += `<p class="mb-2"><strong>${clientTranslations.get('shipping_rule_type')}</strong>${ruleTypeName}</p>`;
      html += `<p class="mb-2"><strong>${clientTranslations.get('shipping_base_price')}</strong>${rule.base_price || 0}</p>`;
      html += `</div>`;

      // 根据规则类型显示详细信息
      if (rule.rule_type !== 'fixed') {
        html += `<div class="mb-3">`;
        html += `<p class="mb-2"><strong>${clientTranslations.get('shipping_unit_price')}</strong>${rule.unit_price || 0}</p>`;
        
        if (rule.min_value !== undefined && rule.min_value !== null) {
          html += `<p class="mb-2"><strong>${clientTranslations.get('shipping_min_value')}</strong>${rule.min_value}</p>`;
        }
        
        if (rule.unit_increment !== undefined && rule.unit_increment !== null) {
          html += `<p class="mb-2"><strong>${clientTranslations.get('shipping_unit_increment')}</strong>${rule.unit_increment}</p>`;
        }
        
        html += `</div>`;
      }

      // 运费计算公式说明（使用国际化）
      html += `<div class="mb-3">`;
      html += `<p class="mb-1"><strong>${clientTranslations.get('shipping_calculation')}</strong></p>`;
      
      let formulaText = '';
      switch (rule.rule_type) {
        case 'quantity':
          formulaText = clientTranslations.get('shipping_formula_quantity')
            .replace('{basePrice}', String(rule.base_price || 0))
            .replace('{unitPrice}', String(rule.unit_price || 0));
          break;
        case 'volume':
          formulaText = clientTranslations.get('shipping_formula_volume')
            .replace('{basePrice}', String(rule.base_price || 0))
            .replace('{minValue}', String(rule.min_value || 0))
            .replace('{unitPrice}', String(rule.unit_price || 0));
          break;
        case 'weight':
          formulaText = clientTranslations.get('shipping_formula_weight')
            .replace('{basePrice}', String(rule.base_price || 0))
            .replace('{minValue}', String(rule.min_value || 0))
            .replace('{unitPrice}', String(rule.unit_price || 0));
          break;
        case 'amount':
          formulaText = clientTranslations.get('shipping_formula_amount')
            .replace('{basePrice}', String(rule.base_price || 0))
            .replace('{minValue}', String(rule.min_value || 0))
            .replace('{unitPrice}', String(rule.unit_price || 0));
          break;
        case 'fixed':
          formulaText = clientTranslations.get('shipping_formula_fixed')
            .replace('{basePrice}', String(rule.base_price || 0));
          break;
        default:
          formulaText = clientTranslations.get('shipping_formula_default')
            .replace('{basePrice}', String(rule.base_price || 0));
      }
      html += `<p class="mb-0 text-muted">${formulaText}</p>`;
      html += `</div>`;

      // 区域信息（如果globalProductData中有regionsData）
      if (globalProductData && globalProductData.regionsData && globalProductData.regionsData.data) {
        const regionName = clientShipping.getRegionName(
          rule.region_id,
          globalProductData.regionsData.data.regions,
          locale
        );
        if (regionName) {
          html += `<div class="mb-3">`;
          html += `<p class="mb-0"><strong>${clientTranslations.get('shipping_applicable_region')}</strong>${regionName}</p>`;
          html += `</div>`;
        }
      }

      // 状态（使用国际化）
      html += `<div class="mb-3">`;
      const statusText = rule.status === 'active' 
        ? clientTranslations.get('shipping_status_active')
        : clientTranslations.get('shipping_status_inactive');
      html += `<p class="mb-0"><strong>${clientTranslations.get('shipping_rule_status')}</strong>${statusText}</p>`;
      html += `</div>`;

      return html;
    }

    // 绑定运费规则弹窗关闭事件
    function bindShippingRuleModalCloseEvents() {
      const modal = document.getElementById('shipping-rule-modal');
      const overlay = document.getElementById('shipping-rule-modal-overlay');
      const closeBtn = document.getElementById('shipping-rule-modal-close');
      
      const closeModal = () => {
        if (modal) {
          modal.style.display = 'none';
        }
        if (overlay) {
          overlay.style.display = 'none';
        }
      };

      if (closeBtn) {
        closeBtn.onclick = closeModal;
      }
      
      if (overlay) {
        overlay.onclick = closeModal;
      }
    }

    // 初始化运费和税费摘要
    function initShippingTaxSummary(data: {
      articleMain: ArticleMainData;
      shippingTemplates: ShippingTemplateData[];
      taxTemplates: TaxTemplateData[];
      regionsData: RegionsData | null;
      userProfile: UserProfileData | null;
      config: ReturnType<typeof getGlobalConfig>;
    }) {
      const { shippingTemplates, taxTemplates, regionsData, userProfile, config } = data;

      // 显示运费税费摘要区域
      const summaryContainer = document.getElementById('shipping-tax-summary');
      if (!summaryContainer) {
        return;
      }
      summaryContainer.style.display = 'block';

      // 检查是否有运费模板和税费模板
      if (!shippingTemplates || shippingTemplates.length === 0) {
        const errorMessage = clientTranslations.get('no_shipping_templates');
        setShippingTaxError('NO_SHIPPING_TEMPLATE', errorMessage);
        const errorElement = document.getElementById('shipping-tax-error');
        const errorMsgElement = document.getElementById('error-message');
        if (errorElement && errorMsgElement) {
          errorMsgElement.textContent = errorMessage;
          errorElement.style.display = 'block';
        }
        return;
      }

      if (!taxTemplates || taxTemplates.length === 0) {
        const errorMessage = clientTranslations.get('no_tax_templates');
        setShippingTaxError('NO_TAX_TEMPLATE', errorMessage);
        const errorElement = document.getElementById('shipping-tax-error');
        const errorMsgElement = document.getElementById('error-message');
        if (errorElement && errorMsgElement) {
          errorMsgElement.textContent = errorMessage;
          errorElement.style.display = 'block';
        }
        return;
      }

      // 初始化地址选择器
      if (userProfile && userProfile.data.addresses && userProfile.data.addresses.length > 0) {
        // 有地址，显示地址选择器
        initAddressSelector(userProfile.data.addresses, config);
      } else {
        // 没有地址，显示提示
        showAddressPrompt(config);
      }

      // 初始化运费模板选择器（只要有模板就显示）
      if (shippingTemplates.length > 0) {
        initShippingTemplateSelector(shippingTemplates, config);
      }

      // 更新多语言文本（不含 address-prompt-text，由 syncAddressPromptCopy 按登录态设置）
      updateShippingTaxTranslations(config.locale);
      syncAddressPromptCopy();
    }

    /** 运费区块顶部提示：未登录与已登录无地址的文案不同，且不能被 updateShippingTaxTranslations 覆盖成「请选择地址」 */
    function syncAddressPromptCopy() {
      const addressPrompt = document.getElementById('address-prompt');
      const promptText = document.getElementById('address-prompt-text');
      const loginBtn = document.getElementById('shipping-tax-login-btn');
      const addAddressBtn = document.getElementById('select-address-btn');
      if (!addressPrompt || !promptText) {
        return;
      }
      if (addressPrompt.style.display === 'none') {
        return;
      }
      if (!isAuthenticated()) {
        const msg = clientTranslations.get('shipping_tax_login_required');
        promptText.textContent = msg;
        setShippingTaxError('NOT_LOGGED_IN', msg);
        if (loginBtn) {
          loginBtn.style.display = 'inline-block';
        }
        if (addAddressBtn) {
          addAddressBtn.style.display = 'none';
        }
        return;
      }
      const msg = clientTranslations.get('select_shipping_address');
      promptText.textContent = msg;
      setShippingTaxError('NO_ADDRESS', msg);
      if (loginBtn) {
        loginBtn.style.display = 'none';
      }
      if (addAddressBtn) {
        addAddressBtn.style.display = 'inline-block';
      }
    }

    // 初始化地址选择器
    function initAddressSelector(addresses: Address[], config: ReturnType<typeof getGlobalConfig>) {
      const addressSelector = document.getElementById('address-selector');
      const addressSelectEl = document.getElementById('shipping-address-select');
      const addressPrompt = document.getElementById('address-prompt');
      const addressLabel = document.getElementById('shipping-address-label');
      const detailsCollapsible = document.getElementById('shipping-details-collapsible');
      const summaryCollapsible = document.getElementById('summary-details-collapsible');
      const toggleIcon = document.getElementById('shipping-address-toggle-icon');

      if (!addressSelector || !(addressSelectEl instanceof HTMLSelectElement)) {
        return;
      }
      const addressSelect = addressSelectEl;

      // 隐藏提示
      if (addressPrompt) {
        addressPrompt.style.display = 'none';
      }

      // 显示选择器（但默认收起内容）
      addressSelector.style.display = 'block';

      // 初始化折叠/展开状态（默认收起）
      let isExpanded = false;

      // 折叠/展开函数
      function toggleExpand() {
        isExpanded = !isExpanded;
        
        if (detailsCollapsible) {
          detailsCollapsible.style.display = isExpanded ? 'block' : 'none';
        }
        if (summaryCollapsible) {
          summaryCollapsible.style.display = isExpanded ? 'block' : 'none';
        }
        
        // 旋转图标（收起时-90度，展开时0度）
        if (toggleIcon) {
          toggleIcon.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(-90deg)';
        }
      }

      // 绑定点击事件到标签
      if (addressLabel) {
        addressLabel.addEventListener('click', toggleExpand);
      }

      // 清空选项
      addressSelect.innerHTML = '';
      
      // 添加默认选项
      const defaultOption = document.createElement('option');
      defaultOption.value = '';
      defaultOption.textContent = clientTranslations.get('please_select_address');
      addressSelect.appendChild(defaultOption);

      // 添加地址选项
      addresses.forEach(address => {
        const option = document.createElement('option');
        option.value = address.id;
        option.textContent = `${address.address_name} - ${address.address_line1}`;
        if (address.is_default) {
          option.selected = true;
          // 设置默认地址
          selectedAddress = address;
        }
        addressSelect.appendChild(option);
      });

      // 监听地址选择变化
      addressSelect.addEventListener('change', (e) => {
        const selectedAddressId = (e.target as HTMLSelectElement).value;
        if (selectedAddressId) {
          const address = addresses.find(addr => addr.id === selectedAddressId);
          if (address) {
            selectedAddress = address;
            // 有地址时，清除地址选择错误
            clearShippingTaxError();
            // 重新计算运费和税费
            calculateShippingAndTax();
          }
        } else {
          selectedAddress = null;
          // 取消选择地址，设置错误状态
          const errorMessage = clientTranslations.get('select_shipping_address');
          setShippingTaxError('NO_ADDRESS', errorMessage);
          hideShippingTaxSummary();
        }
      });

      // 如果已选择默认地址，立即计算运费和税费
      if (selectedAddress) {
        // 有地址时，清除地址选择错误
        clearShippingTaxError();
        calculateShippingAndTax();
      } else {
        // 没有选择地址，设置错误状态
        const errorMessage = clientTranslations.get('select_shipping_address');
        setShippingTaxError('NO_ADDRESS', errorMessage);
      }
    }

    // 显示地址提示（文案与登录/添加地址按钮由 syncAddressPromptCopy 设置）
    function showAddressPrompt(_config: ReturnType<typeof getGlobalConfig>) {
      const addressPrompt = document.getElementById('address-prompt');
      const addressSelector = document.getElementById('address-selector');

      if (addressPrompt) {
        if (addressSelector) {
          addressSelector.style.display = 'none';
        }
        addressPrompt.style.display = 'block';
      }
    }

    // 更新运费税费的多语言文本
    function updateShippingTaxTranslations(locale: string) {
      const elements: { id: string; key: string }[] = [
        { id: 'shipping-tax-login-btn-text', key: 'account_menu_login' },
        { id: 'select-address-btn-text', key: 'add_address' },
        { id: 'shipping-address-label', key: 'shipping_address' },
        { id: 'please-select-address-option', key: 'please_select_address' },
        { id: 'shipping-template-label', key: 'shipping_template' },
        { id: 'please-select-template-option', key: 'please_select_template' },
        { id: 'subtotal-label', key: 'subtotal' },
        { id: 'shipping-label', key: 'shipping' },
        { id: 'tax-label', key: 'tax' },
        { id: 'total-label', key: 'total' },
      ];

      elements.forEach(({ id, key }) => {
        const element = document.getElementById(id);
        if (element && id === 'shipping-template-label') {
          // shipping-template-label 需要特殊处理，因为它包含链接
          const labelSpan = element.querySelector('span:first-child');
          if (labelSpan) {
            labelSpan.textContent = clientTranslations.get(key as any);
          } else {
            // 如果没有span，直接设置（保留链接）
            const link = element.querySelector('a');
            const text = clientTranslations.get(key as any);
            if (link) {
              element.innerHTML = `<span>${text}</span>${link.outerHTML}`;
            } else {
              element.textContent = text;
            }
          }
        } else if (element) {
          element.textContent = clientTranslations.get(key as any);
        }
      });

      // 更新"查看运费规则"链接文本
      const viewRuleLink = document.getElementById('view-shipping-rule-link');
      if (viewRuleLink) {
        viewRuleLink.textContent = clientTranslations.get('view_shipping_rule');
      }
    }

    // 初始化数量选择器（监听数量变化，重新计算价格）
    function initQuantitySelector() {
      const quantityInput = document.querySelector('.quantity-num, .qty-input') as HTMLInputElement;
      const minusBtn = document.querySelector('.quantity-arrow-minus, .qty-left-minus');
      const plusBtn = document.querySelector('.quantity-arrow-plus, .qty-right-plus');

      if (!quantityInput) {
        return;
      }

      // 确保初始值为1（因为HTML中value="1"）
      // 延迟设置，避免与jQuery冲突
      setTimeout(() => {
        quantityInput.value = '1';
        console.log('初始化数量输入框值为:', quantityInput.value);
      }, 100);

      // 数量变化时重新计算价格
      const handleQuantityChange = () => {
        console.log('=== 数量变化触发价格重新计算 ===');
        console.log('当前数量输入框值:', quantityInput.value);
        
        if (!globalProductData) {
          console.log('globalProductData 未初始化，跳过价格计算');
          return;
        }

        // 使用 updatePriceAndStock 统一处理价格和库存更新（会自动检查团购状态）
        updatePriceAndStock(currentVariant);
      };

      // 存储上一次的值，用于检测变化
      let lastValue = quantityInput.value;

      // 使用setInterval定期检查值的变化（因为jQuery可能直接修改value而不触发事件）
      const checkInterval = setInterval(() => {
        if (quantityInput.value !== lastValue) {
          console.log('检测到数量变化（通过轮询）:', lastValue, '->', quantityInput.value);
          lastValue = quantityInput.value;
          handleQuantityChange();
        }
      }, 100);

      // 监听输入框的原生事件
      quantityInput.addEventListener('input', () => {
        console.log('input事件触发');
        lastValue = quantityInput.value;
        handleQuantityChange();
      });
      
      quantityInput.addEventListener('change', () => {
        console.log('change事件触发');
        lastValue = quantityInput.value;
        handleQuantityChange();
      });

      // 监听减号按钮点击
      if (minusBtn) {
        minusBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const current = parseInt(quantityInput.value, 10) || 1;
          const next = Math.max(1, current - 1);
          quantityInput.value = String(next);
          lastValue = quantityInput.value;
          handleQuantityChange();
        });
      }

      // 监听加号按钮点击
      if (plusBtn) {
        plusBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const current = parseInt(quantityInput.value, 10) || 1;
          const next = current + 1;
          quantityInput.value = String(next);
          lastValue = quantityInput.value;
          handleQuantityChange();
        });
      }

      // 页面卸载时清理定时器
      window.addEventListener('beforeunload', () => {
        clearInterval(checkInterval);
      });
    }

    // 页面加载完成后执行
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        const articleId = getArticleId();
        if (articleId) {
          loadProductData(articleId);
        } else {
          console.error('Article ID not found');
        }
      });
    } else {
      const articleId = getArticleId();
      if (articleId) {
        loadProductData(articleId);
      } else {
        console.error('Article ID not found');
      }
    }
  })();
</script>
