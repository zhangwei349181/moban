---
/**
 * PostSingle 文章详情区块：标题、图集、正文、标签/分类。
 * 组件记录 type=postsingle 时渲染（旧租户仍可用 code=postsingle / postsingle01–99）。
 * 页面需传入 articleId（由 [prefix]-[id].astro 传入 URL 参数 id）。
 */
import {
  loadPostSingleSectionTemplate,
  resolvePostSingleClientInit,
} from './resolvers/postsingle';
import { isZhLocale, missingTemplateNoticeHtml } from './resolvers/_shared';
import { loadPostSingleSection } from '../../lib/postSingleSection';
import { getTenantId } from '../../lib/i18n';
import { renderPostSingleSectionHtml } from '../../lib/postSingleTemplate';

interface Props {
  metadata: Record<string, unknown>;
  locale: string;
  articleId?: string;
}

const { metadata, locale, articleId: articleIdProp } = Astro.props;
const tenantId = getTenantId(Astro);
const articleId = String(
  articleIdProp ?? Astro.params.id ?? metadata.article_id ?? metadata.articleId ?? ''
).trim();

let html = '';
const clientInit = resolvePostSingleClientInit(metadata, locale);
const cssUrl = clientInit.cssUrl;

try {
  const templateShell = await loadPostSingleSectionTemplate(metadata, locale, Astro.url);
  if (!templateShell) {
    html = missingTemplateNoticeHtml(locale);
  } else {
    const data = await loadPostSingleSection(articleId, locale, tenantId, metadata);
    html = renderPostSingleSectionHtml({
      data,
      templateShell,
      labels: {
        authorByPrefix: isZhLocale(locale) ? '作者' : 'By',
      },
    });
  }
} catch (error) {
  console.error('[postsingle.astro] render failed:', error);
}
---

<div
  class="postsingle-section-slot postsingle-section-slot--bare"
  data-postsingle-slot
  data-article-id={articleId}
  data-use-platform-ui={clientInit.usePlatformUi ? '1' : '0'}
  data-has-custom-init={clientInit.initScriptUrl || clientInit.initScriptInline ? '1' : '0'}
  set:html={html}
/>
{cssUrl && <link rel="stylesheet" href={cssUrl} />}
{clientInit.initScriptUrl && (
  <script src={clientInit.initScriptUrl} data-postsingle-custom-init="url" />
)}
{clientInit.initScriptInline && (
  <script is:inline data-postsingle-custom-init="inline">
    {clientInit.initScriptInline}
  </script>
)}

<script>
  import { bootPostSingle } from '../../lib/postSingleBoot.client';

  function runBoot() {
    const slot = document.querySelector('[data-postsingle-slot]');
    const usePlatformUi = slot?.getAttribute('data-use-platform-ui') !== '0';
    bootPostSingle({ usePlatformUi });
  }

  runBoot();
</script>
